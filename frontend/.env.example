# AXcellent 프론트 설정. 이 파일을 .env 로 복사해서 고친다 (.env 는 커밋하지 않는다).
# 아무것도 안 적으면 데모 모드: 모든 API를 녹화본(src/mock)으로 대신한다.

# off 로 두면 녹화본을 끄고 아래 주소의 실제 백엔드를 부른다
VITE_MOCK=on

# ---------------------------------------------------------------- AI 7개 (ax-backend)
# 고객지원·인사·AI 대화방 공통 로그 (dashboard-api)
VITE_DASHBOARD_API_URL=http://localhost:8020
# 재무 AI (finance) · 안전 관문 (safety, 재무 화면의 보류 결정)
VITE_FINANCE_AGENT_URL=http://localhost:8105
VITE_SAFETY_API_URL=http://localhost:8001
VITE_SAFETY_HUMAN_TOKEN=human:demo
# 총괄 (orchestrator). CORS가 없어 개발 서버 프록시(/orch)로 부른다
ORCHESTRATOR_PROXY_TARGET=http://127.0.0.1:8000
# 총괄 사건 읽기 중계 (shop-api 관리 읽기, 개발용)
VITE_SHOP_ADMIN_API_URL=http://localhost:8010
VITE_SHOP_ADMIN_TOKEN=mock:admin
# 데이터분석 AI (data). 개발 서버 프록시(/data-a2a)로 부른다
DATA_PROXY_TARGET=http://127.0.0.1:8106
VITE_DATA_A2A_TOKEN=mock:dashboard-api
# 기획개발 AI (planning)
VITE_PLANNING_API_URL=http://localhost:8101
# on 이면 다른 AI는 녹화본으로 두고 요청·기획서·개발·배포 탭만 실제 planning을 부른다 (개발 서버 프록시 /planning-api)
# 이때는 위 VITE_PLANNING_API_URL 줄을 지우거나 주석으로 둔다
VITE_PLANNING_LIVE=off
PLANNING_PROXY_TARGET=http://127.0.0.1:8101
# 개발·배포 AI (dev, 8111). 업무 로직은 기획과 같은 planning 도메인
VITE_DEV_API_URL=http://localhost:8111
DEV_PROXY_TARGET=http://127.0.0.1:8111
# 마케팅 AI: 아직 부르는 API가 없다 (화면 안 시연 데이터)

# ---------------------------------------------------------------- 장애 대응 (DejaFix)
# on 이면 다른 AI는 녹화본으로 두고 장애 대응 탭만 실제 DejaFix를 부른다 (VITE_MOCK=off 면 원래 실제로 부름)
VITE_DEJAFIX_LIVE=off
# DejaFix 백엔드 주소. 개발 서버가 /dejafix-api 로 받아 대신 로그인하고 부른다 (dejafix-proxy.ts)
# DejaFix 레포의 scripts/run_with_env.py 로 띄우면 18000, docker compose 기본은 8000(총괄과 겹침)
DEJAFIX_PROXY_TARGET=http://127.0.0.1:18000
# DejaFix 로그인 계정 (viewer 이상). 시드 계정은 admin·oncall, 비밀번호는 DejaFix .env 의 DEMO_ADMIN_PASSWORD 등
# VITE_ 접두사가 없어서 화면 코드에는 실리지 않고 개발 서버만 읽는다
DEJAFIX_USERNAME=
DEJAFIX_PASSWORD=

# ---------------------------------------------------------------- 고객사
VITE_SHOP_WEB_URL=http://localhost:3000
