{
  "name": "@dejafix/common-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "프론트엔드 공용 템플릿: 디자인 토큰, CSS, React 컴포넌트",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./charts": "./src/charts/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b && eslint .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "echarts": ">=5",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "echarts": "^6.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  }
}
