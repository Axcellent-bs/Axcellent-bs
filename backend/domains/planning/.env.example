# agents/planning 전용 환경변수 예시. 복사해서 agents/planning/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 목 데이터·목 관문으로 동작 (CI는 항상 1).
# 시뮬레이터 액션(inbound, deptChat)도 이때만 받는다.
PLANNING_MOCK=

# 공통 LLM_MODEL 대신 이 서비스만 다른 모델을 쓸 때 (v0은 LLM을 쓰지 않는다)
# PLANNING_LLM_MODEL=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
PLANNING_TOKEN=

# 화면(planning-web)이 REST·SSE를 부를 수 있는 출처, 쉼표로 구분
# PLANNING_CORS_ORIGINS=http://localhost:3002,http://localhost:5173

# agent-card.json 경로를 바꿀 때만
# PLANNING_AGENT_CARD=

# 형상관리 연결 (FR-AG-011). 프로그램은 이 설정으로만 고른다. 비우면 목 부품(외부 호출 없음).
# mock(기본) | github
PLANNING_VCS_KIND=
# 대상 레포 owner/name (하나만)
PLANNING_VCS_REPO=
# 접근 토큰. 권한은 대상 레포 하나에 contents·pull requests 읽기·쓰기, checks·commit statuses 읽기만
PLANNING_VCS_TOKEN=
# API 주소. 사내 설치형(Enterprise)이면 https://<호스트>/api/v3
# PLANNING_VCS_BASE_URL=https://api.github.com
# 생성 PR을 병합할 브랜치
# PLANNING_VCS_BASE_BRANCH=dev
