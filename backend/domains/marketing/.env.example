# agents/marketing 전용 환경변수 예시. 복사해서 agents/marketing/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
MARKETING_MOCK=

# 공통 LLM_MODEL 대신 이 서비스만 다른 모델을 쓸 때
# MARKETING_LLM_MODEL=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
MARKETING_TOKEN=

# ---- 이미지·영상 생성 (generate_media). 값은 사람이 넣는다. 비면 실제 공급자 호출은 거부된다 ----
# 영상 공급자: mock(기본) | gemini | seedance | kling | pika | luma | vidu | runway. 모델 기본값은 없다(가격표에 있는 모델만 호출된다)
# MARKETING_IMAGE_PROVIDER=mock
# MARKETING_IMAGE_MODEL=
# MARKETING_VIDEO_PROVIDER=mock
# MARKETING_VIDEO_MODEL=
# 공급자 키 (이름만 정의. 로그·결과에 내지 않는다)
# MARKETING_IMAGE_API_KEY=
# MARKETING_VIDEO_API_KEY=            # gemini 영상용
# MARKETING_SEEDANCE_API_KEY=         # seedance용(BytePlus ModelArk). 모델 예: dreamina-seedance-2-5-260628, dreamina-seedance-2-5-flash-261115. 가격표 항목이 비어 있어 확인 전엔 호출 거부
# MARKETING_KLING_API_KEY=            # kling용(api-singapore.klingai.com API 키). 모델: kling-4.0, kling-4.0-flash, kling-3.0, kling-3.0-turbo, kling-3.0-omni, kling-o1, kling-2.6, kling-2.5-turbo
# MARKETING_FAL_API_KEY=              # fal용(게이트웨이, 모델 ID owner/app). 가격표 항목 없으면 호출 거부
# MARKETING_REPLICATE_API_KEY=        # replicate용(게이트웨이, 모델 ID owner/name). 가격표 항목 없으면 호출 거부
# MARKETING_HIGGSFIELD_API_KEY=       # higgsfield용 <ID>:<SECRET>(모델 ID는 엔드포인트 경로). 가격표 항목 없으면 호출 거부
# MARKETING_WAN_API_KEY=              # wan용(Alibaba Model Studio 국제). 가격표 항목 없으면 호출 거부
# MARKETING_WAN_WORKSPACE_ID=         # wan 작업공간 ID(키 아님)
# MARKETING_PIXVERSE_API_KEY=         # pixverse용. 가격표 항목 없으면 호출 거부
# MARKETING_PIKA_API_KEY=             # pika용(api.dev.pika.art X-API-Key)
# MARKETING_LUMA_API_KEY=             # luma용(agents.lumalabs.ai). 가격표 항목 없음 = 확인 전엔 호출 거부
# MARKETING_VIDU_API_KEY=             # vidu용(api.vidu.com). 가격표 항목 없음 = 확인 전엔 호출 거부
# MARKETING_RUNWAY_API_KEY=           # runway용(api.dev.runwayml.com API 비밀키). 모델 gen4.5·veo3.1·veo3.1_fast
# 환율(원/USD)·기준일(YYYY-MM-DD)·허용 경과일·추정 여유(%). 비었거나 기준일이 오래되면 실제 공급자 거부
# MARKETING_FX_USD_KRW=
# MARKETING_FX_AS_OF=
# MARKETING_FX_MAX_AGE_DAYS=
# MARKETING_COST_SAFETY_MARGIN_PCT=
# 건당·월 상한(원, 이미지+영상 합산). 비면 실제 공급자 거부
# MARKETING_MEDIA_MAX_COST_KRW_PER_ITEM=
# MARKETING_MEDIA_MONTHLY_BUDGET_KRW=
# 비용 장부(SQLite 파일). 비우면 메모리라 다시 시작할 때 월 누적이 0이 된다
# MARKETING_MEDIA_LEDGER_DB=
# 생성물 저장 폴더. 비우면 시스템 임시 폴더 아래 marketing_media 게시(draft_sns_post)의 asset_path도 이 폴더 안쪽만 받는다(같은 폴더를 공유).
# MARKETING_MEDIA_DIR=
# 자동 게시 스위치(꺼짐=paused)의 '초기 기본값'. DB(sns_publish_control 표)에 행이 없을 때만 쓴다(기본 꺼짐).
# 평소 켜고 끄는 일은 화면 토글(set_publish_control)이나 DB로 한다. 행이 생기면 행이 우선한다
# MARKETING_SNS_PUBLISH_PAUSED=
# SNS 초안 저장 SQLite 파일. 비우면 메모리(다시 시작하면 사라짐)
# MARKETING_SNS_DRAFT_DB=
# AI 라벨 오버레이 설정 파일(기본: src/marketing_agent/sns_label.toml)과 한글 글꼴 파일
# MARKETING_SNS_LABEL_CONFIG=
# MARKETING_SNS_LABEL_FONT=
# ---- Instagram 이미지 호스트 (S3 호환 버킷, 선택). 버킷 이름을 넣으면 켜진다. 값은 사람이 넣는다 ----
# 버킷은 비공개로 두고, Meta에는 유효기간 있는 읽기 전용 서명 URL만 넘긴다. 키는 로그·결과에 내지 않는다
# MARKETING_MEDIA_S3_BUCKET=
# MARKETING_MEDIA_S3_ACCESS_KEY_ID=
# MARKETING_MEDIA_S3_SECRET_ACCESS_KEY=
# S3 호환 서비스 주소(R2: https://<계정 ID>.r2.cloudflarestorage.com). 비우면 AWS
# MARKETING_MEDIA_S3_ENDPOINT=
# 리전(R2는 auto). 기본 us-east-1
# MARKETING_MEDIA_S3_REGION=
# true면 주소/버킷/키 방식. 주소를 주면 기본 true
# MARKETING_MEDIA_S3_PATH_STYLE=
# 오브젝트 폴더(기본 ig/)와 서명 URL 유효 시간(초, 기본 3600, 최대 86400)
# MARKETING_MEDIA_S3_PREFIX=
# MARKETING_MEDIA_S3_URL_TTL_S=

# ---- Instagram 연결 (MARKETING_SNS_PROVIDER=instagram일 때, 값은 사람이 .env에만 넣는다) ----
# 기본 호스트는 https://graph.instagram.com(Instagram Login, 코드 DEFAULT_API_BASE)이지만 MARKETING_IG_API_BASE_URL로 바꿀 수 있다.
# 2026-11-18 기준 251 서버 설정은 https://graph.facebook.com + v27.0(Facebook Login 쪽, 코드 기본값과 다름, 서버 읽기 전용 확인).
# 호스트에 따라 필요한 토큰·권한이 다르다: Instagram Login은 instagram_business_*, Facebook Login은 instagram_basic·
# instagram_content_publish·pages_read_engagement(pages_show_list 의존). 비교표는 docs/notes/marketing/sns-design.md 6절
# MARKETING_IG_API_BASE_URL=
# MARKETING_IG_API_VERSION=
# MARKETING_IG_ACCESS_TOKEN=
# MARKETING_IG_USER_ID=
# MARKETING_IG_APP_SECRET=
# MARKETING_IG_CAROUSEL_ENABLED=

# ---- 공식 SNS 팔로워 수 (channel_followers, 읽기 전용) ----
# 팔로워를 읽을 채널(쉼표 구분). 지금은 instagram만. 비면 unknown. Instagram 연결은 MARKETING_SNS_PROVIDER=instagram과
# MARKETING_IG_ACCESS_TOKEN·MARKETING_IG_USER_ID(게시와 같은 값)를 쓰고, 없으면 unknown이다
# MARKETING_FOLLOWER_CHANNELS=
