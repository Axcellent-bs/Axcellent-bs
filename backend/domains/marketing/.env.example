# agents/marketing 전용 환경변수 예시. 복사해서 agents/marketing/.env로 쓴다 (커밋 금지).
# 공통 변수(TENANT_ID, REDIS_URL, LLM_* 등)는 루트 .env에 둔다.

# 1이면 LLM·외부 호출 대신 가짜 응답 (CI는 항상 1)
MARKETING_MOCK=

# 공통 LLM_MODEL 대신 이 서비스만 다른 모델을 쓸 때
# MARKETING_LLM_MODEL=

# 이 서비스의 에이전트 토큰 (requester는 토큰에서 꺼낸다)
MARKETING_TOKEN=

# ---- 이미지·영상 생성 (generate_media). 값은 사람이 넣는다. 비면 실제 공급자 호출은 거부된다 ----
# 공급자: mock(기본) 외에는 어댑터가 아직 없어 호출 전에 거부된다. 모델 기본값은 없다
# MARKETING_IMAGE_PROVIDER=mock
# MARKETING_IMAGE_MODEL=
# MARKETING_VIDEO_PROVIDER=mock
# MARKETING_VIDEO_MODEL=
# 공급자 키 (이름만 정의. 로그·결과에 내지 않는다)
# MARKETING_IMAGE_API_KEY=
# MARKETING_VIDEO_API_KEY=
# 환율(원/USD)·기준일(YYYY-MM-DD)·허용 경과일·추정 여유(%). 비었거나 기준일이 오래되면 실제 공급자 거부
# MARKETING_FX_USD_KRW=
# MARKETING_FX_AS_OF=
# MARKETING_FX_MAX_AGE_DAYS=
# MARKETING_COST_SAFETY_MARGIN_PCT=
# 건당·월 상한(원, 이미지+영상 합산). 비면 실제 공급자 거부
# MARKETING_MEDIA_MAX_COST_KRW_PER_ITEM=
# MARKETING_MEDIA_MONTHLY_BUDGET_KRW=
# 비용 장부(SQLite 파일). 비우면 메모리라 다시 시작할 때 월 누적이 0이 된다
# MARKETING_MEDIA_LEDGER_DB=
# 생성물 저장 폴더. 비우면 시스템 임시 폴더 아래 marketing_media 게시(draft_sns_post)의 asset_path도 이 폴더 안쪽만 받는다(같은 폴더를 공유).
# MARKETING_MEDIA_DIR=
# SNS 초안 저장 SQLite 파일. 비우면 메모리(다시 시작하면 사라짐)
# MARKETING_SNS_DRAFT_DB=
# AI 라벨 오버레이 설정 파일(기본: src/marketing_agent/sns_label.toml)과 한글 글꼴 파일
# MARKETING_SNS_LABEL_CONFIG=
# MARKETING_SNS_LABEL_FONT=
# ---- Instagram 이미지 호스트 (S3 호환 버킷, 선택). 버킷 이름을 넣으면 켜진다. 값은 사람이 넣는다 ----
# 버킷은 비공개로 두고, Meta에는 유효기간 있는 읽기 전용 서명 URL만 넘긴다. 키는 로그·결과에 내지 않는다
# MARKETING_MEDIA_S3_BUCKET=
# MARKETING_MEDIA_S3_ACCESS_KEY_ID=
# MARKETING_MEDIA_S3_SECRET_ACCESS_KEY=
# S3 호환 서비스 주소(R2: https://<계정 ID>.r2.cloudflarestorage.com). 비우면 AWS
# MARKETING_MEDIA_S3_ENDPOINT=
# 리전(R2는 auto). 기본 us-east-1
# MARKETING_MEDIA_S3_REGION=
# true면 주소/버킷/키 방식. 주소를 주면 기본 true
# MARKETING_MEDIA_S3_PATH_STYLE=
# 오브젝트 폴더(기본 ig/)와 서명 URL 유효 시간(초, 기본 3600, 최대 86400)
# MARKETING_MEDIA_S3_PREFIX=
# MARKETING_MEDIA_S3_URL_TTL_S=
