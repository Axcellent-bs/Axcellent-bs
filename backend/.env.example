# 루트 .env.example — 공통 변수만 둔다 (사람 승인 경로).
# 복사해서 .env로 쓰고, .env는 절대 커밋하지 않는다.
# 부서별 변수(<접두사>_MOCK 등)는 각 패키지 폴더의 .env.example에 있다.

# 테넌트 id. 모든 테이블·요청·이벤트·카드에 필수
TENANT_ID=shop-demo
# 고객사 이름. LLM 프롬프트 등에 쓴다(예: 재무 결산 설명). 비우면 회사 이름 없이 쓴다
TENANT_NAME=
# 이벤트 버스 (Redis Streams). compose 안에서는 redis://redis:6379/0
REDIS_URL=
# 공용 Postgres. compose 안에서는 postgresql://ax:ax@postgres:5432/ax
DATABASE_URL=
# LLM 설정. agent-template의 OpenAI 호환 래퍼가 읽는다. 코드에 모델을 하드코딩하지 않는다
LLM_MODEL=
LLM_BASE_URL=
# LLM 키는 각자 따로 쓴다
LLM_API_KEY=
# 임베딩 모델 (회사 기억 검색, data 소재↔상품 연결). OpenAI 호환 /embeddings로 부른다
EMBED_MODEL=
# 임베딩만 다른 주소·키로 보낼 때 (문장 생성 LLM 주소가 /embeddings를 안 줄 때 등).
# 비우면 위 LLM_BASE_URL·LLM_API_KEY를 쓴다(예전 동작). 임베딩 주소가 LLM 주소와 다르면
# 그 주소용 EMBED_API_KEY도 넣는다. 안 넣으면 LLM 키를 그 주소로 보내지 않고 임베딩이 설정 오류로
# 실패한다(경고 로그에 빠진 이름만 남는다). 주소가 같으면 키를 비워도 LLM 키를 쓴다
EMBED_BASE_URL=
EMBED_API_KEY=
# 영수증 사진 대조(상담 콘솔 "영수증 대조")는 SUPPORT_VISION=on을 명시하고 위 LLM_*가 있을 때만 켜진다.
# 안 주면 꺼진다(모델만 있어도 켜지지 않는다). 이미지를 읽을 수 있는 모델이어야 한다(예: Gemini).
# 사진 안의 글자는 가릴 수 없어 외부 모델로 그대로 전달되니, 방침(외부 전송·국외 이전 안내)을
# 확인한 뒤에만 켠다. 설명: domains/support/README.md,
# docs/notes/support/2026-11-02-receipt-photo-external-transfer.md
# SUPPORT_VISION=on
# 욕설·모욕이 있거나 화난 문의는 LLM이 요청만 남긴 정중한 문장으로 순화해 상담원에게 보여 준다(원문은 그대로 보존).
# 모델로 가는 글은 개인정보를 가린 글이고, 답변 초안을 만들 때 가는 글과 같다. 쓰지 않으려면 off. 목 모드는 on을 줘야 켜진다.
# SUPPORT_ABUSE_SOFTEN=off
# 부서(서비스)별로 덮어쓸 때는 <부서>_LLM_* (예: 기획은 PLANNING_LLM_*, 개발은 DEV_LLM_*). 없으면 위 LLM_*
# 개발은 PLANNING_LLM_*를 읽지 않는다(#493). 예전처럼 PLANNING_LLM_*만 있으면 한동안 그걸 쓰고 경고를 남긴다
# 임베딩도 같다: <부서>_EMBED_MODEL·<부서>_EMBED_BASE_URL·<부서>_EMBED_API_KEY (예: DATA_EMBED_*)
# 임베딩은 LLM 주소가 /embeddings를 안 주면(예: Anthropic) 위 EMBED_BASE_URL·EMBED_API_KEY를 꼭 넣는다
# 예: 공통은 Gemini, 개발만 Claude (Anthropic의 OpenAI 호환 주소)
# DEV_LLM_MODEL=claude-sonnet-5-5
# DEV_LLM_BASE_URL=https://api.anthropic.com/v1
# DEV_LLM_API_KEY=
# 기획만 다른 모델을 쓸 때
# PLANNING_LLM_MODEL=
# PLANNING_LLM_BASE_URL=
# PLANNING_LLM_API_KEY=

# 서버 PC 게이트웨이(nginx) 공개 포트. infra/compose.server.yml을 함께 쓸 때만 쓰인다 (/ 쇼핑몰, /admin/ 관리자, /admin/planning/ 기획·개발).
# 기본 8080. Zabbix가 80을 쓸 수 있어 8080을 유지한다
AX_GATEWAY_PORT=8080

# 업무 요청 라우터: 켠 서비스 id (쉼표 목록, 예: inquiry,claims). 비우면 전부 켠다.
# 켜지 않은 서비스로 가는 요청은 조직도(config/tenants/<회사>/org.yaml, config/org.yaml이 있으면 그것)의 부서 할 일함으로 간다 (README "업무 요청 라우터")
# AX_ENABLED_SERVICES=inquiry,claims
# 인수인계(handover)는 화면에서 접었다. 이 목록을 직접 줄 때는 handover를 넣지 않는다 (run_all.sh는 알아서 뺀다)

# 회사 설정 폴더 config/tenants/<회사>/ (기본 catbooks). 조직도·data 카탈로그를 정한다 (README "새 회사를 붙일 때")
# AX_TENANT=catbooks

# 캣북스 주문 트래픽(scripts/shop_traffic.py). 분당 주문 수(기본 20), 재고 경고 기준(기본 10)
# SHOP_TRAFFIC_ORDERS_PER_MIN=20
# SHOP_TRAFFIC_LOW_STOCK=10
# 재고 자동 보충(run_all.sh로 띄우면 기본 켜짐, 끄려면 0). 기준 아래 상품을 REFILL_TO개로 채운다. admin 토큰은 run_all.sh가 넘긴다
# scripts/shop_traffic.py를 직접 돌릴 때는 기본 꺼짐이라 SHOP_TRAFFIC_REFILL=1을 줘야 한다
# SHOP_TRAFFIC_REFILL=0
# SHOP_TRAFFIC_REFILL_TO=200
# 읽기 전용 열람 토큰(24자 이상). 총괄 읽기 중계와 장애 상태 읽기만 열고 쓰기는 모두 403이다.
# 화면을 사내망 서버에 정적으로 빌드할 때 VITE_SHOP_VIEWER_TOKEN에 같은 값을 넣는다(관리자 토큰은 넣지 않는다).
# 에이전트 토큰 명부와 따로라 다른 서버로는 통하지 않는다. 비우면 꺼진다
# SHOP_VIEWER_TOKEN=

# dejafix-proxy (서버에서 장애 대응 탭이 DejaFix 실데이터를 보게 하는 읽기 전용 프록시, 포트 8030)
# 대상은 서버에서 닿는 DejaFix 백엔드의 고정 주소. 계정은 viewer 권한만 쓴다 (커밋 금지)
# DEJAFIX_PROXY_TARGET=http://<dejafix-host>:18000
# DEJAFIX_USERNAME=
# DEJAFIX_PASSWORD=

# 네이버 검색어 트렌드 (data 커넥터 connectors/naver_datalab.py, NAVER API HUB 키. 커밋 금지)
# NAVER_HUB_CLIENT_ID=
# NAVER_HUB_CLIENT_SECRET=
# AX_NAVER_DATALAB_URL=https://naverapihub.apigw.ntruss.com/search-trend/v1/search
# NAVER_DATALAB_DAILY_LIMIT=1000

# YouTube 영상 통계 스냅샷 (data youtube_collect, YouTube Data API v3 키. 커밋 금지)
# YOUTUBE_API_KEY=
# AX_YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3
# DATA_YOUTUBE_DB=.data/youtube_snapshots.db

# 인사 AI 전체 직원 수. "전 직원 등록 완료"는 확정된 명부가 이 인원일 때만 표시된다 (없으면 10)
# HR_EXPECTED_MEMBERS=10

# 노션 계정 연결 (기획 › 연결 › 노션의 "노션 계정 연결" 버튼. 둘 다 넣어야 버튼이 켜진다. 커밋 금지)
# 만드는 곳: app.notion.com/developers/connections › 새 연결 (워크스페이스 소유자만)
#   설치 범위 Any workspace(만든 뒤 못 바꿈) · 기능 콘텐츠 읽기만 · Redirect URI는 아래 값
#   Configuration 탭의 Client ID·Secret을 넣는다
# PLANNING_NOTION_CLIENT_ID=
# PLANNING_NOTION_CLIENT_SECRET=
# 비우면 http://localhost:8101/api/planning/notion/oauth/callback. 실서버는 https 주소 (노션에 넣은 값과 똑같이)
# PLANNING_NOTION_REDIRECT_URI=
# 노션 연결을 마치고 돌아갈 화면 주소. 비우면 http://localhost:3090 (실서버는 https)
# PLANNING_WEB_URL=

# 사람별 토큰 (run_all.sh가 이름마다 사람 토큰과 작업 토큰을 만든다. 비우면 공용 토큰 하나만)
# AX_PEOPLE=예진,준하
# 사람 토큰으로도 작업 대기열(MCP)을 쓰게 하려면 1 (기본 0, 작업 토큰만)
# DEV_WORK_ALLOW_HUMAN=0
# 브라우저에서 MCP를 부를 때 허용할 Origin (쉼표). Claude Code처럼 Origin이 없는 도구는 그대로 된다
# DEV_MCP_ALLOWED_ORIGINS=
