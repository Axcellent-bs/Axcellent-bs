# 루트 .env.example — 공통 변수만 둔다 (사람 승인 경로).
# 복사해서 .env로 쓰고, .env는 절대 커밋하지 않는다.
# 부서별 변수(<접두사>_MOCK 등)는 각 패키지 폴더의 .env.example에 있다.

# 테넌트 id. 모든 테이블·요청·이벤트·카드에 필수
TENANT_ID=shop-demo
# 고객사 이름. LLM 프롬프트 등에 쓴다(예: 재무 결산 설명). 비우면 회사 이름 없이 쓴다
TENANT_NAME=
# 이벤트 버스 (Redis Streams). compose 안에서는 redis://redis:6379/0
REDIS_URL=
# 공용 Postgres. compose 안에서는 postgresql://ax:<COMPOSE_POSTGRES_PASSWORD>@postgres:5432/ax
DATABASE_URL=
# LLM 설정. agent-template의 OpenAI 호환 래퍼가 읽는다. 코드에 모델을 하드코딩하지 않는다
LLM_MODEL=
LLM_BASE_URL=
# LLM 키는 각자 따로 쓴다
LLM_API_KEY=
# 임베딩 모델 (회사 기억 검색, data 소재↔상품 연결). OpenAI 호환 /embeddings로 부른다
EMBED_MODEL=
# 임베딩만 다른 주소·키로 보낼 때 (문장 생성 LLM 주소가 /embeddings를 안 줄 때 등).
# 비우면 위 LLM_BASE_URL·LLM_API_KEY를 쓴다(예전 동작). 임베딩 주소가 LLM 주소와 다르면
# 그 주소용 EMBED_API_KEY도 넣는다. 안 넣으면 LLM 키를 그 주소로 보내지 않고 임베딩이 설정 오류로
# 실패한다(경고 로그에 빠진 이름만 남는다). 주소가 같으면 키를 비워도 LLM 키를 쓴다
EMBED_BASE_URL=
EMBED_API_KEY=
# 영수증 사진 대조(상담 콘솔 "영수증 대조")는 SUPPORT_VISION=on을 명시하고 위 LLM_*가 있을 때만 켜진다.
# 안 주면 꺼진다(모델만 있어도 켜지지 않는다). 이미지를 읽을 수 있는 모델이어야 한다(예: Gemini).
# 사진 안의 글자는 가릴 수 없어 외부 모델로 그대로 전달되니, 방침(외부 전송·국외 이전 안내)을
# 확인한 뒤에만 켠다. 설명: domains/support/README.md,
# docs/notes/support/2026-11-02-receipt-photo-external-transfer.md
# SUPPORT_VISION=on
# 욕설·모욕이 있거나 화난 문의는 LLM이 요청만 남긴 정중한 문장으로 순화해 상담원에게 보여 준다(원문은 그대로 보존).
# 모델로 가는 글은 개인정보를 가린 글이고, 답변 초안을 만들 때 가는 글과 같다. 쓰지 않으려면 off. 목 모드는 on을 줘야 켜진다.
# SUPPORT_ABUSE_SOFTEN=off
# 부서(서비스)별로 덮어쓸 때는 <부서>_LLM_* (예: 기획은 PLANNING_LLM_*, 개발은 DEV_LLM_*). 없으면 위 LLM_*
# 개발은 PLANNING_LLM_*를 읽지 않는다(#493). 예전처럼 PLANNING_LLM_*만 있으면 한동안 그걸 쓰고 경고를 남긴다
# 임베딩도 같다: <부서>_EMBED_MODEL·<부서>_EMBED_BASE_URL·<부서>_EMBED_API_KEY (예: DATA_EMBED_*)
# 임베딩은 LLM 주소가 /embeddings를 안 주면(예: Anthropic) 위 EMBED_BASE_URL·EMBED_API_KEY를 꼭 넣는다
# 예: 공통은 Gemini, 개발만 Claude (Anthropic의 OpenAI 호환 주소)
# DEV_LLM_MODEL=claude-sonnet-5-5
# DEV_LLM_BASE_URL=https://api.anthropic.com/v1
# DEV_LLM_API_KEY=
# 기획만 다른 모델을 쓸 때
# PLANNING_LLM_MODEL=
# PLANNING_LLM_BASE_URL=
# PLANNING_LLM_API_KEY=

# 서버 PC 게이트웨이(nginx) 공개 포트. infra/compose.server.yml을 함께 쓸 때만 쓰인다 (/ 쇼핑몰, /admin/ 관리자, /admin/planning/ 기획·개발).
# 기본 8080. Zabbix가 80을 쓸 수 있어 8080을 유지한다
AX_GATEWAY_PORT=8080

# 업무 요청 라우터: 켠 서비스 id (쉼표 목록, 예: inquiry,claims). 비우면 전부 켠다.
# 켜지 않은 서비스로 가는 요청은 조직도(config/tenants/<회사>/org.yaml, config/org.yaml이 있으면 그것)의 부서 할 일함으로 간다 (README "업무 요청 라우터")
# AX_ENABLED_SERVICES=inquiry,claims
# 인수인계(handover)는 화면에서 접었다. 이 목록을 직접 줄 때는 handover를 넣지 않는다 (run_all.sh는 알아서 뺀다)

# 회사 설정 폴더 config/tenants/<회사>/ (기본 catbooks). 조직도·data 카탈로그를 정한다 (README "새 회사를 붙일 때")
# AX_TENANT=catbooks

# 캣북스 판매 서버(shop-api)는 AXcellent가 띄우지 않는다(캣북스 레포 Catbooks-demo/catbooks-demo에서 따로).
# 가상 주문(SHOP_TRAFFIC*)·장애 감지 설정은 캣북스 쪽 .env에 둔다. run_all.sh는 판매 서버 주소를
# 기본 http://127.0.0.1:8010으로 넘긴다. 다른 주소면 아래 값이나 회사 연결(시스템 관리 > 회사 연결, 이쪽이 먼저)
# AX_SHOP_API_URL=http://127.0.0.1:8010
# 읽기 전용 열람 토큰(24자 이상). 총괄·받은 기획안 읽기 중계와 장애 상태 읽기만 열고 쓰기는 모두 403이다.
# 캣북스 shop-api가 검증하고(캣북스 쪽에도 같은 값) dashboard-api가 서버 쪽에서 붙여 부른다(/api/dashboard/shop/*). 화면 빌드에는 넣지 않는다.
# 에이전트 토큰 명부와 따로라 다른 서버로는 통하지 않는다. run_all.sh는 비어 있으면 .data/tokens.env에 만들어 둔다
# SHOP_VIEWER_TOKEN=

# 쇼핑몰 결제(shop-api). fake(기본)는 가짜 결제, toss_test는 사람이 화면에서 결제할 때 토스페이먼츠 테스트 결제.
# TOSS_SECRET_KEY는 토스 "테스트" 시크릿 키(test_로 시작)만. 라이브 키·키 없음이면 가짜 결제로 동작한다
# PAYMENT_PROVIDER=fake
# TOSS_SECRET_KEY=

# dejafix-proxy (서버에서 장애 대응 탭이 DejaFix 실데이터를 보게 하는 읽기 전용 프록시, 포트 8030)
# 대상은 서버에서 닿는 DejaFix 백엔드의 고정 주소. 계정은 viewer 권한만 쓴다 (커밋 금지)
# DEJAFIX_PROXY_TARGET=http://<dejafix-host>:18000
# DEJAFIX_USERNAME=
# DEJAFIX_PASSWORD=

# 네이버 검색어 트렌드 (data 커넥터 connectors/naver_datalab.py, NAVER API HUB 키. 커밋 금지)
# NAVER_HUB_CLIENT_ID=
# NAVER_HUB_CLIENT_SECRET=
# AX_NAVER_DATALAB_URL=https://naverapihub.apigw.ntruss.com/search-trend/v1/search
# NAVER_DATALAB_DAILY_LIMIT=1000
# 같은 HUB 키로 블로그·카페글·뉴스 검색 (connectors/naver_search.py). HUB 앱에서 이 API들을 켠 경우만 동작
# NAVER_SEARCH_DAILY_LIMIT=500

# 네이버 검색광고 API 키워드 도구 (data 커넥터 connectors/naver_searchad.py, 키워드 풀·월간 검색량. 커밋 금지)
# NAVER_SEARCHAD_API_KEY=
# NAVER_SEARCHAD_SECRET=
# NAVER_SEARCHAD_CUSTOMER_ID=
# NAVER_SEARCHAD_DAILY_LIMIT=300

# 인스타그램 (data connectors/instagram_graph.py, Meta 공식 Graph API·graph.facebook.com·GET만. 커밋 금지)
# Facebook 로그인 사용자 토큰. 읽기 권한만 전제: instagram_basic · pages_show_list · pages_read_engagement
# (+ business_discovery에 필요하면 instagram_manage_insights). instagram_content_publish는 요구하지 않는다
# (그래서 인기 오디오는 "권한 필요"로 보일 수 있다). 해시태그 검색은 Instagram Public Content Access 검수 필요.
# 마케팅의 IG_* 변수와 따로 둔다
# DATA_IG_ACCESS_TOKEN=
# DATA_IG_USER_ID=
# DATA_IG_API_VERSION=v23.0
# DATA_IG_DAILY_LIMIT=150
# 우리 계정 미디어 인사이트·계정 시청층(video_insights, instagram_manage_insights 권한 필요) 읽는 간격(시간)
# DATA_IG_INSIGHTS_EVERY_HOURS=24

# YouTube 영상 통계 스냅샷 (data youtube_collect, YouTube Data API v3 키. 커밋 금지)
# YOUTUBE_API_KEY=
# AX_YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3
# DATA_YOUTUBE_DB=.data/youtube_snapshots.db

# 유튜브 깊은 지표 (data connectors/youtube_analytics.py, YouTube Analytics·Reporting API, 채널 주인 OAuth.
# 읽기만: yt-analytics.readonly. Reporting job은 사람이 만든다(코드는 만들지 않음). 커밋 금지)
# 옛 이름(YT_CLIENT_ID·YT_CLIENT_SECRET·YT_REFRESH_TOKEN)도 정식 이름이 비어 있으면 읽는다
# DATA_YT_OAUTH_CLIENT_ID=
# DATA_YT_OAUTH_CLIENT_SECRET=
# DATA_YT_REFRESH_TOKEN=
# DATA_YT_ANALYTICS_EVERY_HOURS=24
# DATA_YT_ANALYTICS_DAILY_LIMIT=200

# 매출 분석 표준 판매 저장소 (data sales_collect가 shop-api 판매 기록을 받아 쌓고 sales_analysis가 읽는다)
# DATA_SALES_DB=.data/sales.db
# 판매 기록 수집 간격(초, 최소 60). run_all.sh가 data와 함께 이 간격으로 띄운다
# DATA_SALES_SYNC_SECONDS=300
# 원본 판매 기록을 디스크에 두지 않기(3단계 3-3 A안). memory면 sales_collect는 안내만 하고 끝나고,
# 데이터 AI가 회사 사이트에서 받아 메모리에만 둔다(재시작하면 다시 받음). 비움 = 예전처럼 sales.db에 쌓음
# DATA_SALES_STORE=memory
# 판매 기록의 고객사 ID (없으면 shop-demo)
# DATA_SALES_TENANT_ID=
# 판매 기록·고객 출처. 비움(기본) = 실제 판매 서버(회사 카탈로그 커넥터, 캣북스 shop-api).
# fake = 가짜 출처(데모 전용, data_agent/catalogs/fake/<카탈로그>.toml로 같은 계약 모양의 가상
# 회원·주문을 만든다. 분석 근거에 "가짜 데이터(데모용)"가 보인다). 공용 서버 251에서는 절대 켜지 않는다.
# 가짜로 채운 판매 저장소(DATA_SALES_DB)는 실제 서버로 돌아갈 때 따로 두거나 지운다
# DATA_SALES_SOURCE=

# 성과 결과를 기획에 자동으로 보내기 (data → planning receive_campaign_update). 기본 꺼짐.
# safety registry에 send_campaign_update 항목이 생긴 뒤 1로 켠다
DATA_SEND_CAMPAIGN_UPDATE=

# 인사 AI 전체 직원 수. "전 직원 등록 완료"는 확정된 명부가 이 인원일 때만 표시된다 (없으면 10)
# HR_EXPECTED_MEMBERS=10

# 노션 계정 연결 (기획 › 연결 › 노션의 "노션 계정 연결" 버튼. 둘 다 넣어야 버튼이 켜진다. 커밋 금지)
# 만드는 곳: app.notion.com/developers/connections › 새 연결 (워크스페이스 소유자만)
#   설치 범위 Any workspace(만든 뒤 못 바꿈) · 기능 콘텐츠 읽기만 · Redirect URI는 아래 값
#   Configuration 탭의 Client ID·Secret을 넣는다
# PLANNING_NOTION_CLIENT_ID=
# PLANNING_NOTION_CLIENT_SECRET=
# 비우면 http://localhost:8101/api/planning/notion/oauth/callback. 실서버는 https 주소 (노션에 넣은 값과 똑같이)
# PLANNING_NOTION_REDIRECT_URI=
# 노션 연결을 마치고 돌아갈 화면 주소. 비우면 http://localhost:3090 (실서버는 https)
# PLANNING_WEB_URL=

# 사람별 토큰 (run_all.sh가 이름마다 사람 토큰과 작업 토큰을 만든다. 비우면 공용 토큰 하나만)
# AX_PEOPLE=예진,준하
# 사람 토큰으로도 작업 대기열(MCP)을 쓰게 하려면 1 (기본 0, 작업 토큰만)
# DEV_WORK_ALLOW_HUMAN=0
# 브라우저에서 MCP를 부를 때 허용할 Origin (쉼표). Claude Code처럼 Origin이 없는 도구는 그대로 된다
# DEV_MCP_ALLOWED_ORIGINS=

# 비밀값 저장소 (shared/secret-store/README.md). 기본 env = 지금처럼 이 파일의 값을 쓴다. db로 바꾸는 건 서버 담당자가 순서대로(이전 → 대조 → 전환)
# AX_SECRET_STORE=env
# db 모드에서만: 마스터 키(python -m ax_secret_store keygen). 분실하면 복구할 수 없으니 .env 밖에 따로 백업한다
# AX_SECRET_MASTER_KEY=
# AX_SECRET_MASTER_KEY_ID=k1
# AX_SECRET_DB_FILE=/var/lib/axcellent/secrets.db
# AX_SECRET_DEFAULT_TENANT=default
