#!/usr/bin/env bash
# ax-autodeploy — origin/dev 를 폴링해 "프론트엔드 두 곳 + 홍보 사이트 정적 파일"만 자동 재배포한다.
# 서버의 /usr/local/sbin/ax-autodeploy (root:root 755)로 설치하고, ax-autodeploy.timer 가 90초마다 부른다.
# 설치·정지·롤백은 같은 폴더의 README.md.
#
# 하는 일:  flock -> 정지 표시 확인 -> git fetch origin dev -> 기준 ref 이후 frontend/·docs/promo 변경 판단
#           -> (CI 확인) -> 빌드 전용 트리에서 /opt/axcellent/deploy.sh 재사용 -> 토큰 검사 -> 기준 ref 갱신
# 하지 않는 일: 백엔드·nginx·.env·서비스 재시작, 운영 트리(/opt/axcellent/Axcellent-bs) 변경, 비밀값 출력.
# 백엔드 단계(AX_BACKEND_STAGE=off|dry-run|on, 기본 off): dry-run 은 "지금이면 배포했을 것/보류 사유"를 로그와 공지 문안으로만
#           만든다(배포·재시작·슬랙 전송 없음). on 은 게이트에 rollback-code·uv-sync 가 생길 때까지 미구현으로 막혀 있다.
#           설계: docs/superpowers/specs/2026-11-24-backend-autodeploy-design.md
#
# 사용:  ax-autodeploy [--dry-run]     (--dry-run: 아무것도 바꾸지 않고 무엇을 할지만 출력)
# 끝 코드: 0 정상(건너뜀 포함), 1 실패, 2 사용법 오류
set -Eeuo pipefail
IFS=$' \t\n'
export LC_ALL=C.UTF-8 2>/dev/null || export LC_ALL=C

# ---- 설정(환경 변수로 바꿀 수 있다. 시험은 임시 경로로 한다) --------------------------------------
CONF_FILE="${AX_AUTODEPLOY_CONF:-/etc/ax-autodeploy/env}"   # 선택. root 소유 KEY=값 파일(AX_PAUSE_FILE, AX_MAX_FILES 만 읽는다)
GITHUB_REPO="${AX_GITHUB_REPO:-Axcellent-bs/Axcellent-bs}"
BRANCH="${AX_BRANCH:-dev}"
PROD_REPO="${AX_PROD_REPO:-/opt/axcellent/Axcellent-bs}"     # 운영 트리: backend/.env 의 값을 읽기만 한다
SRC="${AX_SRC:-/opt/axcellent/autodeploy-src}"               # 빌드 전용 트리(별도 clone). 여기서만 fetch/checkout/빌드
DEPLOY_SH="${AX_DEPLOY_SH:-/opt/axcellent/deploy.sh}"
STATE_DIR="${AX_STATE_DIR:-/var/lib/ax-autodeploy}"
LOG_FILE="${AX_LOG_FILE:-/var/log/ax-autodeploy.log}"
BUILD_LOG="${AX_BUILD_LOG:-/var/log/ax-autodeploy-build.log}"
CI_TOKEN_FILE="${AX_CI_TOKEN_FILE:-/etc/ax-autodeploy/gh-readonly-token}"
GATE_BIN="${AX_GATE_BIN:-/usr/local/sbin/ax-gate-autodeploy-paused}"
PAUSE_FILE="${AX_PAUSE_FILE:-}"            # 게이트 정책 [autodeploy] pause_file 경로. 비어 있으면 '미연결'
WEB_ROOT_90="${AX_WEB_ROOT_90:-/var/www/axcellent}"
WEB_ROOT_91="${AX_WEB_ROOT_91:-/var/www/axcellent-admin}"
URL_90="${AX_URL_90:-http://localhost:3090/}"
URL_91="${AX_URL_91:-http://localhost:3090/}"  # 3091 은 허용 IP 만 열려 있어 수동 배포와 같이 3090 으로 확인한다
PROMO_ROOT="${AX_PROMO_ROOT:-/var/www/promo}"
URL_PROMO="${AX_URL_PROMO:-http://localhost:3095/}"
HUMAN_MAP_FILE="${AX_HUMAN_MAP_FILE:-/etc/nginx/conf.d/00-axcellent-human-map.conf}"
MAX_FILES="${AX_MAX_FILES:-500}"
MAX_FAILS="${AX_MAX_FAILS:-3}"
DEPLOY_TIMEOUT="${AX_DEPLOY_TIMEOUT:-1200}"   # 초. 유닛 TimeoutStartSec(1500)보다 짧게
SUDO="${AX_SUDO-sudo}"
HUMAN_PLACEHOLDER="human-via-nginx"

# 백엔드 단계(설계 3~9절). off=아무것도 안 함(기본), dry-run=판정·문안만, on=미구현(게이트 의존)
BACKEND_STAGE="${AX_BACKEND_STAGE:-off}"
DEPLOY_LOCK_FILE="${AX_DEPLOY_LOCK_FILE:-/etc/ax-gate/deploy.lock}"        # 게이트 배포 금지 잠금(있으면 잠김)
WEBHOOK_FILE="${AX_SLACK_WEBHOOK_FILE:-/etc/ax-autodeploy/slack-webhook}"  # root 600. dry-run 에서는 읽지 않는다
BE_QUIET_SEC="${AX_BACKEND_QUIET_SEC:-600}"        # dev 최신 커밋이 이만큼 조용해야 한다(10분)
BE_MIN_GAP_SEC="${AX_BACKEND_MIN_GAP_SEC:-1800}"   # 재시작 사이 최소 간격(30분)
BE_TZ="${AX_BACKEND_TZ:-Asia/Seoul}"               # 시각 기준. 서버 시계(CST)로 직접 비교하지 않는다. 시험용으로만 바꾼다
BE_HOUR_FROM="${AX_BACKEND_HOUR_FROM:-9}"          # KST 시각 [from, to)
BE_HOUR_TO="${AX_BACKEND_HOUR_TO:-22}"
BE_MAX_COMMITS="${AX_BACKEND_MAX_COMMITS:-50}"     # 범위 안 커밋이 더 많으면 판정 불가로 보류
MEMO_LABEL="${AX_MEMO_LABEL:-manual-deploy}"
MEMO_REQUIRED_SINCE="${AX_MEMO_REQUIRED_SINCE:-}"  # 비어 있으면 '섹션 없음'을 메모 없음으로 본다(템플릿 도입 전). 값은 YYYY-MM-DD(UTC 머지일 이후는 섹션 필수)
PYTHON="${AX_PYTHON:-python3}"

LAST_REF_FILE="${STATE_DIR}/last-deployed-ref"
FAIL_FILE="${STATE_DIR}/fail-count"      # "<sha> <횟수>"
SKIP_FILE="${STATE_DIR}/skipped-ref"     # 3회 연속 실패로 건너뛰는 커밋
HEARTBEAT_FILE="${STATE_DIR}/last-run"
PREV_DIR="${STATE_DIR}/prev"
BE_VERDICT_FILE="${STATE_DIR}/backend-verdict"           # "<sha> <판정키>" 마지막 판정(바뀔 때만 로그)
BE_NOTIFIED_FILE="${STATE_DIR}/backend-notified"         # "<sha> <종류>" 공지 문안을 이미 만든 기록(SHA마다 한 번)
BE_LAST_RESTART_FILE="${STATE_DIR}/backend-last-restart" # 마지막 백엔드 재시작 epoch(실제 배포 단계가 쓴다. dry-run 은 읽기만)
BE_INPROGRESS_FILE="${STATE_DIR}/backend-in-progress"    # 있으면 이전 배포가 중간에 죽은 것: 아무것도 안 하고 사람을 부른다

DRY=0
case "${1:-}" in
  "") ;;
  --dry-run) DRY=1 ;;
  *) printf '사용법: %s [--dry-run]\n' "${0##*/}" >&2; exit 2 ;;
esac

# ---- 로그(비밀값은 절대 적지 않는다) --------------------------------------------------------------
log() {
  local tag=""
  [[ ${DRY} == 1 ]] && tag=" [dry-run]"
  local line
  line="$(date '+%Y-%m-%d %H:%M:%S%z') [$$]${tag} $*"
  printf '%s\n' "${line}"
  if [[ ${DRY} == 0 ]]; then printf '%s\n' "${line}" >> "${LOG_FILE}" 2>/dev/null || true; fi
}
heartbeat() { [[ ${DRY} == 1 ]] || printf '%s %s\n' "$(date '+%F %T%z')" "$*" > "${HEARTBEAT_FILE}" 2>/dev/null || true; }
say() { printf '%s\n' "$*"; }   # dry-run 보고용(로그 파일에 안 남는다)

# 설정 파일: root 소유이고 다른 사람이 쓸 수 없을 때만, 알려진 키만 읽는다(내용을 실행하지 않는다).
load_conf() {
  [[ -f "${CONF_FILE}" && ! -L "${CONF_FILE}" ]] || return 0
  local owner mode k v
  owner="$(stat -c %u "${CONF_FILE}")"; mode="$(stat -c %a "${CONF_FILE}")"
  if [[ "${owner}" != 0 && "${AX_CONF_ALLOW_NONROOT:-}" != 1 ]]; then return 0; fi
  [[ "${mode}" =~ [2367]$ || "${mode}" =~ [2367].$ ]] && return 0
  while IFS='=' read -r k v || [[ -n "${k}" ]]; do
    v="${v%\"}"; v="${v#\"}"
    case "${k}" in
      AX_PAUSE_FILE) [[ -n "${AX_PAUSE_FILE:-}" ]] || PAUSE_FILE="${v}" ;;
      AX_MAX_FILES) [[ "${v}" =~ ^[0-9]{1,6}$ ]] && MAX_FILES="${v}" ;;
      AX_BACKEND_STAGE) [[ -n "${AX_BACKEND_STAGE:-}" ]] || BACKEND_STAGE="${v}" ;;
    esac
  done < "${CONF_FILE}"
  return 0
}
load_conf

case "${BACKEND_STAGE}" in
  off|dry-run) ;;
  on)
    log "error: AX_BACKEND_STAGE=on 은 미구현: 게이트 의존(rollback-code·uv-sync 동작이 게이트에 생길 때까지 막아 둠). off 또는 dry-run 만 쓸 수 있다"
    exit 1 ;;
  *)
    log "error: AX_BACKEND_STAGE=${BACKEND_STAGE//[^A-Za-z0-9._-]/?} 는 알 수 없는 값(off|dry-run)"
    exit 1 ;;
esac

# ---- 중복 실행 방지 -------------------------------------------------------------------------------
mkdir -p "${STATE_DIR}" 2>/dev/null || true
exec 9> "${STATE_DIR}/lock"
if ! flock -n 9; then
  log "busy: 다른 ax-autodeploy 가 실행 중이라 건너뜀"
  exit 0
fi

# ---- 정지 표시 확인 -------------------------------------------------------------------------------
GATE_STATE="NOT-CONNECTED (pause_file 설정 또는 ${GATE_BIN} 없음)"
if [[ -n "${PAUSE_FILE}" && -x "${GATE_BIN}" ]]; then
  PAUSE_MSG="$(mktemp)"
  if "${GATE_BIN}" "${PAUSE_FILE}" 2>"${PAUSE_MSG}"; then
    log "paused: $(head -c 200 "${PAUSE_MSG}" | tr -d '\n') -> 이번 주기 건너뜀"
    rm -f "${PAUSE_MSG}"
    heartbeat "paused"
    [[ ${DRY} == 1 ]] && say "정지 중이라 이번 주기는 건너뛴다"
    exit 0
  fi
  rm -f "${PAUSE_MSG}"
  GATE_STATE="connected (정지 아님)"
fi

# ---- 다른 배포가 돌고 있으면 건너뜀 ---------------------------------------------------------------
# 앱의 배포 도구·사람이 /opt/axcellent/deploy.sh 를 직접 돌리는 중이면 같은 웹 루트(.new/.old 이름까지 같다)를 건드리지 않는다.
OTHER_DEPLOY_PATTERN="${AX_OTHER_DEPLOY_PATTERN:-^(/bin/|/usr/bin/)?bash .*/opt/axcellent/deploy\.sh}"
if pgrep -f "${OTHER_DEPLOY_PATTERN}" >/dev/null 2>&1; then
  log "other-deploy-running: /opt/axcellent/deploy.sh 가 이미 돌고 있어 이번 주기 건너뜀"
  heartbeat "other-deploy-running"
  exit 0
fi

# ---- 상태 읽기·fetch ------------------------------------------------------------------------------
[[ -d "${SRC}/.git" ]] || { log "error: 빌드 전용 트리 ${SRC} 가 없다(README 설치 3번)"; exit 1; }
[[ -r "${LAST_REF_FILE}" ]] || { log "error: ${LAST_REF_FILE} 가 없다(README 설치 4번: 현재 배포된 커밋으로 시드)"; exit 1; }
LAST="$(tr -d ' \r\n' < "${LAST_REF_FILE}")"
[[ "${LAST}" =~ ^[0-9a-f]{40}$ ]] || { log "error: ${LAST_REF_FILE} 내용이 커밋 해시가 아니다"; exit 1; }

git_src() { git -C "${SRC}" "$@"; }
if ! timeout 120 git -C "${SRC}" fetch --quiet origin "${BRANCH}" 2>>"${BUILD_LOG}"; then
  log "error: git fetch origin ${BRANCH} 실패(다음 주기에 다시)"
  heartbeat "fetch-failed"
  exit 1
fi
TARGET="$(git_src rev-parse --verify "origin/${BRANCH}^{commit}")"
git_src cat-file -e "${LAST}^{commit}" 2>/dev/null || { log "error: 기준 ref ${LAST:0:8} 가 저장소에 없다(수동 확인 필요)"; exit 1; }

# ---- 백엔드 단계(dry-run: 판정·문안만. 배포·재시작·슬랙 전송은 하지 않는다) --------------------------
# 설계 3~9절. 기준은 last-deployed-ref 가 아니라 운영 트리의 실제 HEAD. 확인할 수 없으면(API 오류·판정 불가) 이번 주기를 건너뛴다.
# 항상 0 으로 끝난다(프론트·홍보 단계를 막지 않는다).
BE_TOK=""
be_gh_get() { # $1=저장소 기준 API 경로. 성공하면 본문을 출력
  curl -fsS --max-time 30 -H "Authorization: Bearer ${BE_TOK}" -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/${GITHUB_REPO}/$1" 2>/dev/null
}

# 판정 기록. $1=종류(would-deploy|hold-memo|wait) $2=판정 키 $3=사유 $4=공지 문안(선택, 종류가 would-deploy·hold-memo 일 때)
# 로그는 판정이 바뀔 때만 남기고, 공지 문안은 SHA·종류마다 한 번만 만든다. 문안은 로그에만 적는다(전송 안 함).
be_note() {
  local kind="$1" key="$2" reason="$3" draft="${4:-}" prev="" line
  [[ -r "${BE_VERDICT_FILE}" ]] && prev="$(cat "${BE_VERDICT_FILE}" 2>/dev/null || true)"
  if [[ ${DRY} == 1 || "${prev}" != "${TARGET} ${key}" ]]; then
    log "backend-dry-run: ${key} ${PROD_HEAD:0:8}..${TARGET:0:8} ${reason}"
  fi
  [[ ${DRY} == 1 ]] || printf '%s %s\n' "${TARGET}" "${key}" > "${BE_VERDICT_FILE}" 2>/dev/null || true
  [[ -n "${draft}" ]] || return 0
  if [[ ${DRY} == 0 ]] && grep -qxF "${TARGET} ${kind}" "${BE_NOTIFIED_FILE}" 2>/dev/null; then return 0; fi
  while IFS= read -r line; do log "backend-notice-draft(${kind}, 전송 안 함): ${line}"; done <<< "${draft}"
  [[ ${DRY} == 1 ]] || printf '%s %s\n' "${TARGET}" "${kind}" >> "${BE_NOTIFIED_FILE}" 2>/dev/null || true
  return 0
}

# 슬랙 전송 자리 표시. dry-run 에서는 호출하지 않는다(on 단계가 구현될 때 쓴다). 웹훅 주소는 파일에서만 읽고 출력하지 않는다.
be_announce() { # $1=문안. 0=올림, 1=못 올림(그러면 배포하지 않는다)
  [[ ${BACKEND_STAGE} == on && -r "${WEBHOOK_FILE}" ]] || return 1
  local url; url="$(tr -d ' \r\n' < "${WEBHOOK_FILE}")"
  [[ -n "${url}" ]] || return 1
  printf '%s' "$1" | "${PYTHON}" -I -c 'import json,sys;print(json.dumps({"text":sys.stdin.read()}))' \
    | curl -fsS --max-time 20 -H 'Content-Type: application/json' --data-binary @- "${url}" >/dev/null 2>&1
}

backend_stage() {
  [[ "${BACKEND_STAGE}" == "dry-run" ]] || return 0
  local PROD_HEAD n f now hour gap age last c uv_note=""
  # 1) 중간에 죽은 배포 흔적·배포 금지 잠금(정지 표시는 위에서 이미 확인했다)
  PROD_HEAD="$(git -C "${PROD_REPO}" rev-parse --verify 'HEAD^{commit}' 2>/dev/null || true)"
  if [[ ! "${PROD_HEAD}" =~ ^[0-9a-f]{40}$ ]]; then
    log "backend-dry-run: skip-cycle 운영 트리 ${PROD_REPO} 의 HEAD 를 못 읽음(이번 주기 건너뜀)"; return 0
  fi
  if [[ -e "${BE_INPROGRESS_FILE}" ]]; then
    be_note wait in-progress-file "backend-in-progress 가 남아 있음(이전 배포가 중간에 죽음): 아무것도 하지 않고 사람 확인이 필요하다"; return 0
  fi
  if [[ -e "${DEPLOY_LOCK_FILE}" ]]; then
    be_note wait deploy-lock "배포 금지 잠금(${DEPLOY_LOCK_FILE}) 걸려 있음"; return 0
  fi

  # 2) 운영 트리 HEAD..dev 최신에 backend/ 변경이 있는가
  [[ "${PROD_HEAD}" == "${TARGET}" ]] && return 0
  if ! git_src cat-file -e "${PROD_HEAD}^{commit}" 2>/dev/null || ! git_src merge-base --is-ancestor "${PROD_HEAD}" "${TARGET}" 2>/dev/null; then
    be_note wait prod-head-not-in-dev "운영 트리 HEAD 가 origin/${BRANCH} 의 조상이 아님(앞서 있거나 갈라짐): 사람 확인 필요"; return 0
  fi
  local -a BE_FILES=()
  mapfile -t BE_FILES < <(git_src diff --name-only "${PROD_HEAD}" "${TARGET}" -- backend/ 2>/dev/null)
  n="${#BE_FILES[@]}"
  if (( n == 0 )); then
    [[ ${DRY} == 1 ]] && say "백엔드 단계: 운영 트리 ${PROD_HEAD:0:8}..${TARGET:0:8} 에 backend/ 변경 없음"
    return 0
  fi
  for f in "${BE_FILES[@]}"; do
    case "${f}" in backend/uv.lock|backend/pyproject.toml|backend/*/pyproject.toml|backend/*/*/pyproject.toml) uv_note=" [uv sync 필요: 게이트 미구현]" ;; esac
  done

  # 3) 조건 1: check-runs 중 ci·backend 만 completed+success
  if [[ ! -r "${CI_TOKEN_FILE}" ]]; then
    be_note wait ci-off "읽기 전용 토큰 파일 없음: 백엔드는 확인 없이 배포하지 않는다"; return 0
  fi
  BE_TOK="$(tr -d ' \r\n' < "${CI_TOKEN_FILE}")"
  if [[ -z "${BE_TOK}" ]]; then be_note wait ci-off "토큰 파일이 비어 있음"; return 0; fi
  local body verdict
  if ! body="$(be_gh_get "commits/${TARGET}/check-runs?per_page=100")"; then
    BE_TOK=""; log "backend-dry-run: skip-cycle check-runs API 실패(${TARGET:0:8}; 이번 주기 건너뜀)"; return 0
  fi
  verdict="$(printf '%s' "${body}" | "${PYTHON}" -I -c '
import json,sys
need=("ci","backend")
runs=json.load(sys.stdin).get("check_runs",[])
fail=[];pend=[]
for nm in need:
    rs=[r for r in runs if r.get("name")==nm]
    if not rs: pend.append(nm+"(없음)"); continue
    r=max(rs,key=lambda x:x.get("id",0))
    if r.get("status")!="completed": pend.append(nm+"(진행 중)")
    elif r.get("conclusion")=="success": pass
    elif r.get("conclusion") in ("failure","timed_out","action_required"): fail.append(nm)
    else: pend.append(nm+"("+str(r.get("conclusion"))+")")
print("fail:"+",".join(fail) if fail else ("pending:"+",".join(pend) if pend else "ok"))' 2>/dev/null || echo "parse-error")"
  case "${verdict}" in
    ok) ;;
    fail:*) BE_TOK=""; be_note wait ci-fail "CI 실패 ${verdict#fail:} (${TARGET:0:8})"; return 0 ;;
    pending:*) BE_TOK=""; be_note wait ci-pending "CI 대기 ${verdict#pending:} (${TARGET:0:8})"; return 0 ;;
    *) BE_TOK=""; log "backend-dry-run: skip-cycle check-runs 해석 실패(이번 주기 건너뜀)"; return 0 ;;
  esac

  # 4) 조건 4: 범위 안 커밋마다 PR 을 찾아 라벨·'## 배포 메모' 를 본다(PR 을 못 찾거나 API 실패면 보류)
  local -a COMMITS=()
  mapfile -t COMMITS < <(git_src rev-list "${PROD_HEAD}..${TARGET}")
  if (( ${#COMMITS[@]} > BE_MAX_COMMITS )); then
    BE_TOK=""; be_note wait too-many-commits "범위 안 커밋 ${#COMMITS[@]}개(> ${BE_MAX_COMMITS}): 판정하지 않고 보류"; return 0
  fi
  local pr_dir; pr_dir="$(mktemp -d)"
  for c in "${COMMITS[@]}"; do
    if ! be_gh_get "commits/${c}/pulls?per_page=30" > "${pr_dir}/${c}.json"; then
      BE_TOK=""; rm -rf "${pr_dir}"
      log "backend-dry-run: skip-cycle PR 조회 API 실패(${c:0:8}; 보류, 이번 주기 건너뜀)"; return 0
    fi
  done
  BE_TOK=""
  local pr_res
  pr_res="$("${PYTHON}" -I -c '
import json,re,sys,os
label,since,d=sys.argv[1],sys.argv[2],sys.argv[3]
memo=[];nopr=[];prs=[]
def section(body):
    body=re.sub(r"<!--.*?-->","",body or "",flags=re.S)
    out=None
    for ln in body.splitlines():
        s=ln.strip()
        if out is None:
            if re.match(r"^#{2}\s*배포\s*메모\s*$",s): out=[]
        else:
            if re.match(r"^#{1,6}\s",ln.lstrip()): break
            out.append(ln)
    return None if out is None else "\n".join(out)
for fn in sorted(os.listdir(d)):
    sha=fn[:-5]
    try: lst=json.load(open(os.path.join(d,fn),encoding="utf-8"))
    except Exception: print("error"); sys.exit()
    if not isinstance(lst,list): print("error"); sys.exit()
    if not lst: nopr.append(sha[:8]); continue
    for p in lst:
        num="#"+str(p.get("number"))
        if num not in prs: prs.append(num)
        names=[l.get("name") for l in (p.get("labels") or [])]
        if label in names: memo.append(num+" 라벨 "+label); continue
        sec=section(p.get("body"))
        if sec is None:
            if since and (not p.get("merged_at") or p["merged_at"][:10]>=since): memo.append(num+" 본문에 배포 메모 섹션 없음")
            continue
        norm=re.sub(r"[\s\.\-\*_`~>:!]+","",sec)
        if norm not in ("","없음"): memo.append(num+" 배포 메모 있음")
print("memo|"+"; ".join(memo) if memo else ("nopr|"+",".join(nopr) if nopr else "ok|"+" ".join(prs)))
' "${MEMO_LABEL}" "${MEMO_REQUIRED_SINCE}" "${pr_dir}" 2>/dev/null || echo error)"
  rm -rf "${pr_dir}"
  case "${pr_res}" in
    memo\|*)
      be_note hold-memo memo "배포 메모 판정: ${pr_res#memo|}" \
"[tencent] 자동 배포 보류(dry-run): ${pr_res#memo|}. 손으로 배포해 주세요. 대상 ${TARGET:0:8}.${uv_note}"
      return 0 ;;
    nopr\|*) be_note wait no-pr "PR 을 못 찾은 커밋 ${pr_res#nopr|}: 판정 불가라 보류"; return 0 ;;
    ok\|*) ;;
    *) log "backend-dry-run: skip-cycle PR 응답 해석 실패(이번 주기 건너뜀)"; return 0 ;;
  esac

  # 5) 조건 5: KST 9~22시, dev 최신 커밋 10분 조용, 마지막 재시작과 30분 간격
  now="${AX_BACKEND_NOW:-$(date +%s)}"
  hour="$(TZ="${BE_TZ}" date -d "@${now}" +%H 2>/dev/null || true)"
  if [[ ! "${hour}" =~ ^[0-9]{2}$ ]]; then log "backend-dry-run: skip-cycle 시각을 못 구함(이번 주기 건너뜀)"; return 0; fi
  if (( 10#${hour} < BE_HOUR_FROM || 10#${hour} >= BE_HOUR_TO )); then
    be_note wait outside-hours "KST ${hour}시는 배포 시간(${BE_HOUR_FROM}~${BE_HOUR_TO}시) 밖"; return 0
  fi
  last="$(git_src log -1 --format=%ct "${TARGET}" 2>/dev/null || true)"
  if [[ ! "${last}" =~ ^[0-9]+$ ]]; then log "backend-dry-run: skip-cycle 최신 커밋 시각을 못 읽음(이번 주기 건너뜀)"; return 0; fi
  age=$(( now - last ))
  if (( age < BE_QUIET_SEC )); then
    be_note wait not-quiet "dev 최신 커밋이 ${age}초 전(조용해지려면 ${BE_QUIET_SEC}초 필요)"; return 0
  fi
  if [[ -r "${BE_LAST_RESTART_FILE}" ]]; then
    gap="$(tr -d ' \r\n' < "${BE_LAST_RESTART_FILE}")"
    if [[ "${gap}" =~ ^[0-9]+$ ]] && (( now - gap < BE_MIN_GAP_SEC )); then
      be_note wait min-gap "마지막 재시작이 $(( now - gap ))초 전(최소 ${BE_MIN_GAP_SEC}초)"; return 0
    fi
  fi

  be_note would-deploy would-deploy "지금이면 배포했을 것(backend ${n}개 파일, PR ${pr_res#ok|}, CI ci·backend 통과)${uv_note}" \
"[tencent] 자동 배포(dry-run, 실제 배포 안 함): 백엔드 ${PROD_HEAD:0:8} → ${TARGET:0:8} 를 지금이면 배포하고 재시작했을 것입니다.
포함 PR: ${pr_res#ok|} (backend ${n}개 파일) / CI: ci·backend 통과${uv_note}
재시작하면 메모리에만 있는 상태(승인 대기·진행 중 작업)가 지워집니다."
  return 0
}
backend_stage || log "backend-dry-run: skip-cycle 내부 오류(rc=$?; 이번 주기 건너뜀)"

if [[ "${TARGET}" == "${LAST}" ]]; then
  heartbeat "up-to-date ${TARGET:0:8}"
  [[ ${DRY} == 1 ]] && say "배포할 것 없음: origin/${BRANCH}=${TARGET:0:8} 가 기준과 같다"
