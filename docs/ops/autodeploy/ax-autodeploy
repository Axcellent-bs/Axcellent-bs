#!/usr/bin/env bash
# ax-autodeploy — origin/dev 를 폴링해 "프론트엔드 두 곳 + 홍보 사이트 정적 파일"만 자동 재배포한다.
# 서버의 /usr/local/sbin/ax-autodeploy (root:root 755)로 설치하고, ax-autodeploy.timer 가 90초마다 부른다.
# 설치·정지·롤백은 같은 폴더의 README.md.
#
# 하는 일:  flock -> 정지 표시 확인 -> git fetch origin dev -> 기준 ref 이후 frontend/·docs/promo 변경 판단
#           -> (CI 확인) -> 빌드 전용 트리에서 /opt/axcellent/deploy.sh 재사용 -> 토큰 검사 -> 기준 ref 갱신
# 하지 않는 일: nginx·.env 변경, 비밀값 출력, 운영 트리·서비스는 게이트(ax-gate)로만(백엔드 단계 on 일 때) 바꾼다.
# 백엔드 단계(AX_BACKEND_STAGE=off|dry-run|on, 기본 off): dry-run 은 "지금이면 배포했을 것/보류 사유"를 로그와 공지 문안으로만
#           만든다(배포·재시작·슬랙 전송 없음). on 은 같은 판정을 통과하면 게이트(ax-gate 0.5.0)로 실제 배포한다:
#           공지 -> deploy-bundle -> (uv.lock·pyproject.toml 변경이면 uv-sync) -> restart-backend, 실패하면
#           rollback-bundle -> rollback-code -> (uv-sync 직전) -> (restart 단계 실패였으면 restart-backend 직전 SHA).
#           잘못된 단계 값은 off 로 보고 프론트·홍보 단계는 그대로 돈다.
#           설계: docs/superpowers/specs/2026-11-24-backend-autodeploy-design.md
#
# 사용:  ax-autodeploy [--dry-run]     (--dry-run: 아무것도 바꾸지 않고 무엇을 할지만 출력)
# 끝 코드: 0 정상(건너뜀 포함), 1 실패, 2 사용법 오류
set -Eeuo pipefail
IFS=$' \t\n'
export LC_ALL=C.UTF-8 2>/dev/null || export LC_ALL=C

# ---- 설정(환경 변수로 바꿀 수 있다. 시험은 임시 경로로 한다) --------------------------------------
CONF_FILE="${AX_AUTODEPLOY_CONF:-/etc/ax-autodeploy/env}"   # 선택. root 소유 KEY=값 파일(AX_PAUSE_FILE, AX_MAX_FILES, AX_BACKEND_STAGE, AX_ALLOW_HOURS, AX_MEMO_REQUIRED_SINCE, AX_BACKEND_*_SEC 만 읽는다)
GITHUB_REPO="${AX_GITHUB_REPO:-Axcellent-bs/Axcellent-bs}"
BRANCH="${AX_BRANCH:-dev}"
PROD_REPO="${AX_PROD_REPO:-/opt/axcellent/Axcellent-bs}"     # 운영 트리: backend/.env 의 값을 읽기만 한다
SRC="${AX_SRC:-/opt/axcellent/autodeploy-src}"               # 빌드 전용 트리(별도 clone). 여기서만 fetch/checkout/빌드
DEPLOY_SH="${AX_DEPLOY_SH:-/opt/axcellent/deploy.sh}"
STATE_DIR="${AX_STATE_DIR:-/var/lib/ax-autodeploy}"
LOG_FILE="${AX_LOG_FILE:-/var/log/ax-autodeploy.log}"
BUILD_LOG="${AX_BUILD_LOG:-/var/log/ax-autodeploy-build.log}"
CI_TOKEN_FILE="${AX_CI_TOKEN_FILE:-/etc/ax-autodeploy/gh-readonly-token}"
GATE_BIN="${AX_GATE_BIN:-/usr/local/sbin/ax-gate-autodeploy-paused}"
PAUSE_FILE="${AX_PAUSE_FILE:-}"            # 게이트 정책 [autodeploy] pause_file 경로. 비어 있으면 '미연결'
WEB_ROOT_90="${AX_WEB_ROOT_90:-/var/www/axcellent}"
WEB_ROOT_91="${AX_WEB_ROOT_91:-/var/www/axcellent-admin}"
URL_90="${AX_URL_90:-http://localhost:3090/}"
URL_91="${AX_URL_91:-http://localhost:3090/}"  # 3091 은 허용 IP 만 열려 있어 수동 배포와 같이 3090 으로 확인한다
PROMO_ROOT="${AX_PROMO_ROOT:-/var/www/promo}"
URL_PROMO="${AX_URL_PROMO:-http://localhost:3095/}"
HUMAN_MAP_FILE="${AX_HUMAN_MAP_FILE:-/etc/nginx/conf.d/00-axcellent-human-map.conf}"
MAX_FILES="${AX_MAX_FILES:-500}"
MAX_FAILS="${AX_MAX_FAILS:-3}"
DEPLOY_TIMEOUT="${AX_DEPLOY_TIMEOUT:-1200}"   # 초. 유닛 TimeoutStartSec(1500)보다 짧게
SUDO="${AX_SUDO-sudo}"
HUMAN_PLACEHOLDER="human-via-nginx"

# 백엔드 단계(설계 3~9절). off=아무것도 안 함(기본), dry-run=판정·문안만, on=미구현(게이트 의존)
BACKEND_STAGE="${AX_BACKEND_STAGE:-off}"
DEPLOY_LOCK_FILE="${AX_DEPLOY_LOCK_FILE:-/etc/ax-gate/deploy.lock}"        # 게이트 배포 금지 잠금(있으면 잠김)
WEBHOOK_FILE="${AX_SLACK_WEBHOOK_FILE:-/etc/ax-autodeploy/slack-webhook}"  # root 600. dry-run 에서는 읽지 않는다
BE_QUIET_SEC="${AX_BACKEND_QUIET_SEC:-600}"        # dev 최신 커밋이 이만큼 조용해야 한다(10분)
BE_MIN_GAP_SEC="${AX_BACKEND_MIN_GAP_SEC:-3600}"   # 재시작 사이 최소 간격(60분)
BE_DEFER_MAX_SEC="${AX_BACKEND_DEFER_MAX_SEC:-14400}"  # 미루기 상한(4시간). 넘기면 알림만 한다(강제 재시작 없음)
BE_TZ="${AX_BACKEND_TZ:-Asia/Seoul}"               # 시각 기준. 서버 시계(CST)로 직접 비교하지 않는다. 시험용으로만 바꾼다
ALLOW_HOURS="${AX_ALLOW_HOURS:-0-24}"              # 배포 허용 시각(KST) "시작-끝", [시작, 끝). 기본은 24시간. 요일 제한은 없다
BUSY_URLS="${AX_BUSY_URLS:-}"                      # 선택. 공백으로 나눈 조회 주소: 대기·진행 건이 있으면(또는 조회 실패) 재시작을 미룬다
GATE_SUDO="${AX_GATE_SUDO-sudo -n -u axautodeploy}" # 게이트 호출 앞머리(시험은 빈 값)
GATE_EXEC="${AX_GATE_EXEC:-/usr/local/sbin/ax-gate}"
GATE_TIMEOUT="${AX_GATE_TIMEOUT:-420}"             # 게이트 동작 하나의 제한 시간(초)
BE_MAX_COMMITS="${AX_BACKEND_MAX_COMMITS:-50}"     # 범위 안 커밋이 더 많으면 판정 불가로 보류
BE_GREEN_SCAN="${AX_BACKEND_GREEN_SCAN:-15}"      # green 커밋 탐색: tip 부터 이 개수까지만 check-runs 를 조회(API 호출 상한)
MEMO_LABEL="${AX_MEMO_LABEL:-manual-deploy}"
MEMO_REQUIRED_SINCE="${AX_MEMO_REQUIRED_SINCE:-}"  # 비어 있으면 '섹션 없음'을 메모 없음으로 본다(템플릿 도입 전). 값은 YYYY-MM-DD(UTC 머지일 이후는 섹션 필수)
PYTHON="${AX_PYTHON:-python3}"

LAST_REF_FILE="${STATE_DIR}/last-deployed-ref"
FAIL_FILE="${STATE_DIR}/fail-count"      # "<sha> <횟수>"
SKIP_FILE="${STATE_DIR}/skipped-ref"     # 3회 연속 실패로 건너뛰는 커밋
HEARTBEAT_FILE="${STATE_DIR}/last-run"
PREV_DIR="${STATE_DIR}/prev"
BE_VERDICT_FILE="${STATE_DIR}/backend-verdict"           # "<sha> <판정키>" 마지막 판정(바뀔 때만 로그)
BE_NOTIFIED_FILE="${STATE_DIR}/backend-notified"         # "<sha> <종류>" 공지 문안을 이미 만든 기록(SHA마다 한 번)
BE_LAST_RESTART_FILE="${STATE_DIR}/backend-last-restart" # 마지막 백엔드 재시작 epoch(실제 배포 단계가 쓴다. dry-run 은 읽기만)
BE_INPROGRESS_FILE="${STATE_DIR}/backend-in-progress"    # 있으면 이전 배포가 중간에 죽은 것: 아무것도 안 하고 사람을 부른다
BE_SKIPPED_FILE="${STATE_DIR}/backend-skipped-ref"       # 백엔드 배포가 1회 실패한 커밋: 새 커밋이 올 때까지 다시 시도하지 않는다
BE_DEFER_FILE="${STATE_DIR}/backend-defer-since"         # "<운영 HEAD> <처음 미룬 epoch>": 미루기 상한 계산
BE_GREEN_FILE="${STATE_DIR}/backend-green-select"         # "<tip> <선택한 green>" 마지막 green-select(바뀔 때만 로그)
BE_DEPLOYED=""                                            # 백엔드 배포를 시도한 TARGET(green 선택이면 tip 과 다를 수 있다)

DRY=0
case "${1:-}" in
  "") ;;
  --dry-run) DRY=1 ;;
  *) printf '사용법: %s [--dry-run]\n' "${0##*/}" >&2; exit 2 ;;
esac

# ---- 로그(비밀값은 절대 적지 않는다) --------------------------------------------------------------
log() {
  local tag=""
  [[ ${DRY} == 1 ]] && tag=" [dry-run]"
  local line
  line="$(date '+%Y-%m-%d %H:%M:%S%z') [$$]${tag} $*"
  printf '%s\n' "${line}"
  if [[ ${DRY} == 0 ]]; then printf '%s\n' "${line}" >> "${LOG_FILE}" 2>/dev/null || true; fi
}
heartbeat() { [[ ${DRY} == 1 ]] || printf '%s %s\n' "$(date '+%F %T%z')" "$*" > "${HEARTBEAT_FILE}" 2>/dev/null || true; }
say() { printf '%s\n' "$*"; }   # dry-run 보고용(로그 파일에 안 남는다)

# 설정 파일: root 소유이고 다른 사람이 쓸 수 없을 때만, 알려진 키만 읽는다(내용을 실행하지 않는다).
load_conf() {
  [[ -f "${CONF_FILE}" && ! -L "${CONF_FILE}" ]] || return 0
  local owner mode k v
  owner="$(stat -c %u "${CONF_FILE}")"; mode="$(stat -c %a "${CONF_FILE}")"
  if [[ "${owner}" != 0 && "${AX_CONF_ALLOW_NONROOT:-}" != 1 ]]; then return 0; fi
  [[ "${mode}" =~ [2367]$ || "${mode}" =~ [2367].$ ]] && return 0
  while IFS='=' read -r k v || [[ -n "${k}" ]]; do
    v="${v%\"}"; v="${v#\"}"
    case "${k}" in
      AX_PAUSE_FILE) [[ -n "${AX_PAUSE_FILE:-}" ]] || PAUSE_FILE="${v}" ;;
      AX_MAX_FILES) [[ "${v}" =~ ^[0-9]{1,6}$ ]] && MAX_FILES="${v}" ;;
      AX_BACKEND_STAGE) [[ -n "${AX_BACKEND_STAGE:-}" ]] || BACKEND_STAGE="${v}" ;;
      AX_ALLOW_HOURS) [[ "${v}" =~ ^[0-9]{1,2}-[0-9]{1,2}$ && -z "${AX_ALLOW_HOURS:-}" ]] && ALLOW_HOURS="${v}" ;;
      AX_MEMO_REQUIRED_SINCE) [[ "${v}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && -z "${AX_MEMO_REQUIRED_SINCE:-}" ]] && MEMO_REQUIRED_SINCE="${v}" ;;
      AX_BACKEND_MIN_GAP_SEC) [[ "${v}" =~ ^[0-9]{1,7}$ && -z "${AX_BACKEND_MIN_GAP_SEC:-}" ]] && BE_MIN_GAP_SEC="${v}" ;;
      AX_BACKEND_QUIET_SEC) [[ "${v}" =~ ^[0-9]{1,7}$ && -z "${AX_BACKEND_QUIET_SEC:-}" ]] && BE_QUIET_SEC="${v}" ;;
      AX_BACKEND_DEFER_MAX_SEC) [[ "${v}" =~ ^[0-9]{1,7}$ && -z "${AX_BACKEND_DEFER_MAX_SEC:-}" ]] && BE_DEFER_MAX_SEC="${v}" ;;
    esac
  done < "${CONF_FILE}"
  return 0
}
load_conf

case "${BACKEND_STAGE}" in
  off|dry-run|on) ;;
  *)
    # 잘못된 값이 프론트·홍보 단계를 막으면 안 된다: 백엔드 단계만 끄고 계속한다
    log "error: AX_BACKEND_STAGE=${BACKEND_STAGE//[^A-Za-z0-9._-]/?} 는 알 수 없는 값(off|dry-run|on): 백엔드 단계는 off 로 보고 프론트·홍보 단계만 돈다"
    BACKEND_STAGE=off ;;
esac

# ---- 중복 실행 방지 -------------------------------------------------------------------------------
mkdir -p "${STATE_DIR}" 2>/dev/null || true
exec 9> "${STATE_DIR}/lock"
if ! flock -n 9; then
  log "busy: 다른 ax-autodeploy 가 실행 중이라 건너뜀"
  exit 0
fi

# ---- 정지 표시 확인 -------------------------------------------------------------------------------
GATE_STATE="NOT-CONNECTED (pause_file 설정 또는 ${GATE_BIN} 없음)"
if [[ -n "${PAUSE_FILE}" && -x "${GATE_BIN}" ]]; then
  PAUSE_MSG="$(mktemp)"
  if "${GATE_BIN}" "${PAUSE_FILE}" 2>"${PAUSE_MSG}"; then
    log "paused: $(head -c 200 "${PAUSE_MSG}" | tr -d '\n') -> 이번 주기 건너뜀"
    rm -f "${PAUSE_MSG}"
    heartbeat "paused"
    [[ ${DRY} == 1 ]] && say "정지 중이라 이번 주기는 건너뛴다"
    exit 0
  fi
  rm -f "${PAUSE_MSG}"
  GATE_STATE="connected (정지 아님)"
fi

# ---- 다른 배포가 돌고 있으면 건너뜀 ---------------------------------------------------------------
# 앱의 배포 도구·사람이 /opt/axcellent/deploy.sh 를 직접 돌리는 중이면 같은 웹 루트(.new/.old 이름까지 같다)를 건드리지 않는다.
OTHER_DEPLOY_PATTERN="${AX_OTHER_DEPLOY_PATTERN:-^(/bin/|/usr/bin/)?bash .*/opt/axcellent/deploy\.sh}"
if pgrep -f "${OTHER_DEPLOY_PATTERN}" >/dev/null 2>&1; then
  log "other-deploy-running: /opt/axcellent/deploy.sh 가 이미 돌고 있어 이번 주기 건너뜀"
  heartbeat "other-deploy-running"
  exit 0
fi

# ---- 상태 읽기·fetch ------------------------------------------------------------------------------
[[ -d "${SRC}/.git" ]] || { log "error: 빌드 전용 트리 ${SRC} 가 없다(README 설치 3번)"; exit 1; }
[[ -r "${LAST_REF_FILE}" ]] || { log "error: ${LAST_REF_FILE} 가 없다(README 설치 4번: 현재 배포된 커밋으로 시드)"; exit 1; }
LAST="$(tr -d ' \r\n' < "${LAST_REF_FILE}")"
[[ "${LAST}" =~ ^[0-9a-f]{40}$ ]] || { log "error: ${LAST_REF_FILE} 내용이 커밋 해시가 아니다"; exit 1; }

git_src() { git -C "${SRC}" "$@"; }
if ! timeout 120 git -C "${SRC}" fetch --quiet origin "${BRANCH}" 2>>"${BUILD_LOG}"; then
  log "error: git fetch origin ${BRANCH} 실패(다음 주기에 다시)"
  heartbeat "fetch-failed"
  exit 1
fi
TARGET="$(git_src rev-parse --verify "origin/${BRANCH}^{commit}")"
git_src cat-file -e "${LAST}^{commit}" 2>/dev/null || { log "error: 기준 ref ${LAST:0:8} 가 저장소에 없다(수동 확인 필요)"; exit 1; }

# ---- 백엔드 단계(dry-run: 판정·문안만 / on: 같은 판정을 통과하면 게이트로 실제 배포) ----------------
# 설계 3~9절. 기준은 last-deployed-ref 가 아니라 운영 트리의 실제 HEAD. 확인할 수 없으면(API 오류·판정 불가·공지 실패) 이번 주기를 건너뛴다.
# on 이 아니면 항상 0 으로 끝난다(프론트·홍보 단계를 막지 않는다). on 의 배포 결과는 반환 코드로 알린다: 10 배포 완료, 11 실패 후 되돌림 완료, 12 되돌림도 실패.
BE_TOK=""
BE_NOW=""
MODE="off"        # off | dry-run(--dry-run 플래그 포함) | on
BE_TAG="backend"
advance_ref() { # 기준 ref 갱신(배포가 필요 없었거나, 배포가 검증까지 끝났을 때만)
  [[ ${DRY} == 1 ]] && return 0
  printf '%s\n' "$1" > "${LAST_REF_FILE}.tmp" && mv -f "${LAST_REF_FILE}.tmp" "${LAST_REF_FILE}"
  rm -f "${FAIL_FILE}" "${SKIP_FILE}"
}
be_gh_get() { # $1=저장소 기준 API 경로. 성공하면 본문을 출력
  curl -fsS --max-time 30 -H "Authorization: Bearer ${BE_TOK}" -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/${GITHUB_REPO}/$1" 2>/dev/null
}

# 슬랙 전송. 웹훅 주소는 파일에서만 읽고 출력하지 않는다. 0=올림, 1=못 올림(on 에서만 보낸다. dry-run·--dry-run 은 읽지도 않는다)
be_announce() { # $1=문안
  [[ ${MODE} == on && -r "${WEBHOOK_FILE}" ]] || return 1
  local url; url="$(tr -d ' \r\n' < "${WEBHOOK_FILE}")"
  [[ -n "${url}" ]] || return 1
  printf '%s' "$1" | "${PYTHON}" -I -c 'import json,sys;print(json.dumps({"text":sys.stdin.read()}))' \
    | curl -fsS --max-time 20 -H 'Content-Type: application/json' --data-binary @- "${url}" >/dev/null 2>&1
}
# 배포 흐름 중간 공지(끝·실패·되돌림). 못 올려도 흐름은 계속한다(되돌림은 멈추면 안 된다).
be_alert() {
  be_announce "$1" || log "${BE_TAG}: notice-failed 슬랙 공지를 못 올림(웹훅 파일·네트워크 확인)"
}
# 같은 SHA·종류의 공지는 한 번만. 0=이미 올렸거나 지금 올림, 1=못 올림
be_announce_once() { # $1=종류 $2=문안
  grep -qxF "${TARGET} $1" "${BE_NOTIFIED_FILE}" 2>/dev/null && return 0
  be_announce "$2" || return 1
  printf '%s %s\n' "${TARGET}" "$1" >> "${BE_NOTIFIED_FILE}" 2>/dev/null || true
  return 0
}

# 판정 기록. $1=종류(would-deploy|hold-memo|defer-cap|wait) $2=판정 키 $3=사유 $4=공지 문안(선택)
# 로그는 판정이 바뀔 때만 남기고, 공지는 SHA·종류마다 한 번만 한다(dry-run 은 문안을 로그에만 적고 전송하지 않는다).
be_note() {
  local kind="$1" key="$2" reason="$3" draft="${4:-}" prev="" line
  [[ -r "${BE_VERDICT_FILE}" ]] && prev="$(cat "${BE_VERDICT_FILE}" 2>/dev/null || true)"
  if [[ ${DRY} == 1 || "${prev}" != "${TARGET} ${key}" ]]; then
    log "${BE_TAG}: ${key} ${PROD_HEAD:0:8}..${TARGET:0:8} ${reason}"
  fi
  [[ ${DRY} == 1 ]] || printf '%s %s\n' "${TARGET}" "${key}" > "${BE_VERDICT_FILE}" 2>/dev/null || true
  [[ -n "${draft}" ]] || return 0
  if [[ ${DRY} == 0 ]] && grep -qxF "${TARGET} ${kind}" "${BE_NOTIFIED_FILE}" 2>/dev/null; then return 0; fi
  if [[ ${MODE} == on ]]; then
    if be_announce "${draft}"; then
      log "${BE_TAG}: notice-sent(${kind}) 슬랙 공지를 올림"
      printf '%s %s\n' "${TARGET}" "${kind}" >> "${BE_NOTIFIED_FILE}" 2>/dev/null || true
    else
      log "${BE_TAG}: notice-failed(${kind}) 슬랙 공지를 못 올림(다음 주기에 다시)"
    fi
    return 0
  fi
  while IFS= read -r line; do log "backend-notice-draft(${kind}, 전송 안 함): ${line}"; done <<< "${draft}"
  [[ ${DRY} == 1 ]] || printf '%s %s\n' "${TARGET}" "${kind}" >> "${BE_NOTIFIED_FILE}" 2>/dev/null || true
  return 0
}

# 미루는 사유(조용한 구간·최소 간격·대기 건). 처음 미룬 때부터 상한(기본 4시간)을 넘기면 알림만 한다(강제 재시작 없음).
be_defer() { # $1=판정 키 $2=사유
  local p="" e="" since="${BE_NOW}"
  if [[ ${MODE} == on ]]; then
    if read -r p e < "${BE_DEFER_FILE}" 2>/dev/null && [[ "${p}" == "${PROD_HEAD}" && "${e}" =~ ^[0-9]+$ ]]; then since="${e}"
    else printf '%s %s\n' "${PROD_HEAD}" "${BE_NOW}" > "${BE_DEFER_FILE}" 2>/dev/null || true; fi
    if (( BE_NOW - since >= BE_DEFER_MAX_SEC )); then
      be_note defer-cap "$1" "$2 (미룬 지 $(( (BE_NOW - since) / 60 ))분, 상한 $(( BE_DEFER_MAX_SEC / 60 ))분 넘김: 강제로 재시작하지 않는다)" \
"[tencent] 자동 배포가 $(( BE_DEFER_MAX_SEC / 3600 ))시간 넘게 미뤄지고 있습니다(${2}). 대상 ${TARGET:0:8}. 강제로 재시작하지 않으니 사람이 정해 주세요."
      return 0
    fi
  fi
  be_note wait "$1" "$2"
}

# 대기·진행 건 조회(AX_BUSY_URLS 가 있을 때만). 0=한가함, 1=대기·진행 건이 있거나 조회 실패(미룬다)
be_busy() {
  local u body res
  for u in ${BUSY_URLS}; do
    if ! body="$(curl -fsS --max-time 10 "${u}" 2>/dev/null)"; then BUSY_WHY="조회 실패(${u%%\?*})"; return 1; fi
    res="$(printf '%s' "${body}" | "${PYTHON}" -I -c '
import json,sys
d=json.load(sys.stdin)
if isinstance(d,dict):
    for k in ("items","reviews","incidents","pending"):
        if isinstance(d.get(k),list): d=d[k]; break
    else: d=d.get("count",d.get("busy",0))
print(len(d) if isinstance(d,list) else int(d))' 2>/dev/null || echo bad)"
    if [[ ! "${res}" =~ ^[0-9]+$ ]]; then BUSY_WHY="조회 응답 해석 실패(${u%%\?*})"; return 1; fi
    if (( res > 0 )); then BUSY_WHY="대기·진행 ${res}건(${u%%\?*})"; return 1; fi
  done
  return 0
}

# 게이트 호출: sudo -n -u axautodeploy env SSH_ORIGINAL_COMMAND="<동작> <SHA> --announced" /usr/local/sbin/ax-gate axautodeploy
GATE_RC=0
gate() { # $@ = 동작 문자열 조각. 끝 코드는 GATE_RC 에도 남긴다. 출력은 빌드 로그로(비밀값 없음)
  local cmd="$*"
  log "${BE_TAG}: gate ${cmd}"
  GATE_RC=0
  # shellcheck disable=SC2086
  timeout "${GATE_TIMEOUT}" ${GATE_SUDO} env SSH_ORIGINAL_COMMAND="${cmd}" "${GATE_EXEC}" axautodeploy >> "${BUILD_LOG}" 2>&1 || GATE_RC=$?
  return "${GATE_RC}"
}

# 실제 배포(on). 공지 -> deploy-bundle -> [uv-sync] -> restart-backend, 실패하면 되돌림(설계 5절).
# 반환: 0=이번 주기 건너뜀(상태 변화 없음), 10=배포 완료, 11=실패 후 되돌림 완료, 12=되돌림도 실패(자동 배포 멈춤)
be_deploy() { # $1=포함 PR 목록 $2=backend 파일 수 $3=uv sync 필요(0|1)
  local prs="$1" nfiles="$2" uv_need="$3" stage="" t0="${SECONDS}" cur rb_ok=1 uv_txt="" restarted=0
  if (( uv_need )); then uv_txt=" (uv.lock·pyproject.toml 변경: uv sync 포함)"; fi
  if ! be_announce_once announce \
"[tencent] 자동 배포: 백엔드 ${PROD_HEAD:0:8} → ${TARGET:0:8} 를 곧 배포하고 재시작합니다.
포함 PR: ${prs} (backend ${nfiles}개 파일) / CI: ci·backend 통과${uv_txt}
재시작하면 메모리에만 있는 상태(승인 대기·진행 중 작업)가 지워집니다.
되돌리는 방법: 실패하면 자동으로 ${PROD_HEAD:0:8} 로 되돌립니다. 멈추려면 autodeploy-pause."; then
    be_note wait announce-failed "배포 전 슬랙 공지를 못 올려 배포하지 않음(공지 없이 --announced 를 쓰지 않는다. 다음 주기에 다시)"
    return 0
  fi
  printf '%s\n' "deploy ${PROD_HEAD} ${TARGET}" > "${BE_INPROGRESS_FILE}"
  if ! gate deploy-bundle "${TARGET}" --announced; then
    if (( GATE_RC == 4 )); then   # 게이트가 바쁨·배포 금지 잠금: 아무것도 바뀌지 않았다
      rm -f "${BE_INPROGRESS_FILE}"
      log "${BE_TAG}: gate-busy deploy-bundle 이 잠금·사용 중으로 거부됨(이번 주기 건너뜀)"; return 0
    fi
    stage="deploy-bundle"
  elif (( uv_need )) && ! gate uv-sync "${TARGET}" --announced; then
    stage="uv-sync"
  elif gate restart-backend "${TARGET}" --ack-data-loss --announced; then
    stage=""; restarted=1
  else
    stage="restart-backend"; restarted=1
  fi

  if [[ -z "${stage}" ]]; then
    printf '%s\n' "${BE_NOW}" > "${BE_LAST_RESTART_FILE}"
    rm -f "${BE_INPROGRESS_FILE}" "${BE_DEFER_FILE}"
    log "${BE_TAG}: deployed ${PROD_HEAD:0:8}->${TARGET:0:8} ($(( SECONDS - t0 ))초)"
    be_alert "[tencent] 자동 배포 끝: 백엔드 ${TARGET:0:8}, 게이트 health 통과 (약 $(( SECONDS - t0 ))초)."
    return 10
  fi

  # ---- 되돌림: rollback-bundle -> rollback-code -> (uv-sync 직전) -> (재시작 단계 실패였으면 restart-backend 직전) ----
  log "${BE_TAG}: FAIL ${stage}(rc=${GATE_RC}) ${TARGET:0:8} -> ${PROD_HEAD:0:8} 로 되돌림 시작"
  printf '%s\n' "rollback ${PROD_HEAD} ${TARGET} ${stage}" > "${BE_INPROGRESS_FILE}"
  printf '%s\n' "${TARGET}" > "${BE_SKIPPED_FILE}"   # 백엔드는 1회 실패로 건너뛴다(새 커밋이 올 때까지)
  gate rollback-bundle "${TARGET}" --announced || rb_ok=0
  gate rollback-code "${TARGET}" --announced || true
  cur="$(git -C "${PROD_REPO}" rev-parse --verify 'HEAD^{commit}' 2>/dev/null || true)"
  if [[ "${cur}" != "${PROD_HEAD}" ]]; then rb_ok=0; fi   # 코드가 직전으로 돌아오지 않았으면 실패(deploy-bundle 이 코드를 안 옮겼다면 이미 같다)
  if (( rb_ok && uv_need )) && [[ "${stage}" != deploy-bundle ]]; then gate uv-sync "${PROD_HEAD}" --announced || rb_ok=0; fi
  if (( rb_ok )) && [[ "${stage}" == restart-backend ]]; then gate restart-backend "${PROD_HEAD}" --ack-data-loss --announced || rb_ok=0; fi
  if (( restarted && rb_ok )); then printf '%s\n' "${BE_NOW}" > "${BE_LAST_RESTART_FILE}"; fi
  if (( rb_ok )); then
    rm -f "${BE_INPROGRESS_FILE}" "${BE_DEFER_FILE}"
    log "${BE_TAG}: rolled-back ${stage} 실패 -> ${PROD_HEAD:0:8} 복구(${TARGET:0:8} 는 새 커밋이 올 때까지 다시 시도하지 않음)"
    be_alert "[tencent] 자동 배포 실패 → ${PROD_HEAD:0:8} 로 되돌렸습니다.
실패 지점: ${stage}. ${TARGET:0:8} 는 새 커밋이 올 때까지 다시 시도하지 않습니다."
    return 11
  fi
  log "${BE_TAG}: ROLLBACK-FAILED ${stage} -> 자동 배포 멈춤(${BE_INPROGRESS_FILE} 를 사람이 확인하고 지울 때까지 아무것도 안 함)"
  printf '%s\n' "halted ${PROD_HEAD} ${TARGET} ${stage}" > "${BE_INPROGRESS_FILE}"
  be_alert "[tencent] 자동 배포 실패, 되돌림도 실패했습니다. 자동 배포를 멈췄습니다. 서버 확인이 필요합니다. (대상 ${TARGET:0:8}, 실패 지점 ${stage})"
  return 12
}

# check-runs JSON(stdin) -> ok | fail:<목록> | hold:<목록> | pending:<목록>. 이름별 가장 큰 id 의 check-run 만 본다.
BE_VERDICT_PY='
import json,sys
runs=json.load(sys.stdin).get("check_runs",[])
fail=[];hold=[];pend=[]
def latest(nm):
    rs=[r for r in runs if r.get("name")==nm]
    return max(rs,key=lambda x:x.get("id",0)) if rs else None
for nm in ("ci","backend"):
    r=latest(nm)
    if r is None: pend.append(nm+"(없음)")
    elif r.get("status")!="completed": pend.append(nm+"(진행 중)")
    elif r.get("conclusion")=="success": pass
    elif r.get("conclusion") in ("failure","timed_out","action_required"): fail.append(nm)
    else: pend.append(nm+"("+str(r.get("conclusion"))+")")
r=latest("data-eval")
if r is None: pend.append("data-eval(없음)")
elif r.get("status")!="completed": hold.append("data-eval(진행 중)")
elif r.get("conclusion") in ("success","skipped","neutral"): pass
elif r.get("conclusion") in ("failure","timed_out","action_required"): fail.append("data-eval")
else: pend.append("data-eval("+str(r.get("conclusion"))+")")
if fail: print("fail:"+",".join(fail))
elif hold: print("hold:"+",".join(hold))
elif pend: print("pending:"+",".join(pend))
else: print("ok")'

backend_stage() {
  case "${BACKEND_STAGE}" in
    dry-run) MODE=dry-run; BE_TAG=backend-dry-run ;;
    on) if [[ ${DRY} == 1 ]]; then MODE=dry-run; BE_TAG=backend-dry-run; else MODE=on; BE_TAG=backend; fi ;;
    *) return 0 ;;
  esac
  local TARGET="${TARGET}" PROD_HEAD n f hour gap age last c uv_need=0 uv_note="" BUSY_WHY="" h_from h_to hold_tag=""   # TARGET: 이 함수 안에서만 green 커밋으로 바꾼다(dynamic scope: be_note·be_deploy 가 이 값을 본다). 프론트 단계는 tip 그대로
  BE_NOW="${AX_BACKEND_NOW:-$(date +%s)}"
  # 1) 중간에 죽은 배포 흔적·배포 금지 잠금·정지 표시(헬퍼가 멈춤으로 판정한 경우는 위에서 이미 건너뛰었다)
  PROD_HEAD="$(git -C "${PROD_REPO}" rev-parse --verify 'HEAD^{commit}' 2>/dev/null || true)"
  if [[ ! "${PROD_HEAD}" =~ ^[0-9a-f]{40}$ ]]; then
    log "${BE_TAG}: skip-cycle 운영 트리 ${PROD_REPO} 의 HEAD 를 못 읽음(이번 주기 건너뜀)"; return 0
  fi
  if [[ -e "${BE_INPROGRESS_FILE}" ]]; then
    be_note wait in-progress-file "backend-in-progress 가 남아 있음(이전 배포가 중간에 죽었거나 되돌림 실패): 아무것도 하지 않고 사람 확인이 필요하다"; return 0
  fi
  if [[ ${MODE} == on ]]; then
    if [[ -z "${PAUSE_FILE}" ]]; then
      be_note wait pause-not-connected "AX_PAUSE_FILE 미설정: 정지 표시를 볼 수 없어 on 에서는 배포하지 않는다"; return 0
    fi
    if [[ -e "${PAUSE_FILE}" && ! -x "${GATE_BIN}" ]]; then
      be_note wait paused-no-helper "정지 표시 파일이 있고 판정 헬퍼(${GATE_BIN})가 없어 멈춘 것으로 본다"; return 0
    fi
  fi
  if [[ -e "${DEPLOY_LOCK_FILE}" ]]; then
    be_note wait deploy-lock "배포 금지 잠금(${DEPLOY_LOCK_FILE}) 걸려 있음"; return 0
  fi

  # 2) 운영 트리 HEAD..dev 최신에 backend/ 변경이 있는가(API 호출 전 값싼 확인. 최신 tip 기준)
  [[ "${PROD_HEAD}" == "${TARGET}" ]] && return 0
  if ! git_src cat-file -e "${PROD_HEAD}^{commit}" 2>/dev/null || ! git_src merge-base --is-ancestor "${PROD_HEAD}" "${TARGET}" 2>/dev/null; then
    be_note wait prod-head-not-in-dev "운영 트리 HEAD 가 origin/${BRANCH} 의 조상이 아님(앞서 있거나 갈라짐): 사람 확인 필요"; return 0
  fi
  local -a BE_FILES=()
  mapfile -t BE_FILES < <(git_src diff --name-only "${PROD_HEAD}" "${TARGET}" -- backend/ 2>/dev/null)
  n="${#BE_FILES[@]}"
  if (( n == 0 )); then
    [[ ${DRY} == 1 ]] && say "백엔드 단계: 운영 트리 ${PROD_HEAD:0:8}..${TARGET:0:8} 에 backend/ 변경 없음"
    return 0
  fi

  # 3) 조건 1: check-runs 중 ci·backend 는 completed+success. data-eval 은 success·skipped 면 통과, 진행 중·실패면 보류, 취소·없음이면 대기.
  #    green 선택: tip 의 CI 가 끝나지 않았어도(푸시가 잦아 cancel-in-progress 로 취소되는 경우) PROD_HEAD..tip 의 first-parent 커밋을
  #    새것부터 최대 BE_GREEN_SCAN 개 훑어 ci 판정이 ok 인 가장 최신 커밋을 TARGET 으로 쓴다. tip 이 fail 이면 훑지 않고 ci-fail.
  if [[ ! -r "${CI_TOKEN_FILE}" ]]; then
    be_note wait ci-off "읽기 전용 토큰 파일 없음: 백엔드는 확인 없이 배포하지 않는다"; return 0
  fi
  BE_TOK="$(tr -d ' \r\n' < "${CI_TOKEN_FILE}")"
  if [[ -z "${BE_TOK}" ]]; then be_note wait ci-off "토큰 파일이 비어 있음"; return 0; fi
  local body verdict tip_verdict="" sel="" TIP="${TARGET}" prev_sel=""
  local -a CAND=()
  mapfile -t CAND < <(git_src rev-list --first-parent --max-count="${BE_GREEN_SCAN}" "${PROD_HEAD}..${TIP}")
  for c in "${CAND[@]}"; do
    if ! body="$(be_gh_get "commits/${c}/check-runs?per_page=100")"; then
      BE_TOK=""; log "${BE_TAG}: skip-cycle check-runs API 실패(${c:0:8}; 이번 주기 건너뜀)"; return 0
    fi
    verdict="$(printf '%s' "${body}" | "${PYTHON}" -I -c "${BE_VERDICT_PY}" 2>/dev/null || echo "parse-error")"
    [[ -n "${tip_verdict}" ]] || tip_verdict="${verdict}"
    case "${verdict}" in
      ok)
        # 선택 후보는 운영 HEAD 의 후손이어야 한다(옛 커밋으로 되돌리는 배포 방지). LAST 는 보지 않는다:
        # 프론트 단계가 web 변경 없는 tip 으로 LAST 를 계속 올리므로, LAST 조건을 걸면 green 선택이 막힌다.
        if git_src merge-base --is-ancestor "${PROD_HEAD}" "${c}" 2>/dev/null; then
          sel="${c}"; break
        fi ;;
      parse-error) BE_TOK=""; log "${BE_TAG}: skip-cycle check-runs 해석 실패(${c:0:8}; 이번 주기 건너뜀)"; return 0 ;;
      fail:*) [[ "${c}" == "${TIP}" ]] && break ;;   # 가장 최신 후보가 실패면 더 옛 커밋으로 내려가지 않는다
    esac
  done
  if [[ -z "${sel}" ]]; then
    case "${tip_verdict}" in
      fail:*) be_note wait ci-fail "CI 실패 ${tip_verdict#fail:} (${TARGET:0:8})"; return 0 ;;
      hold:*) be_note wait ci-hold "CI 보류 ${tip_verdict#hold:} (${TARGET:0:8})"; return 0 ;;
      pending:*) be_note wait ci-pending "CI 대기 ${tip_verdict#pending:} (${TARGET:0:8}; 최근 ${#CAND[@]}개 커밋 중 green 없음)"; return 0 ;;
      *) log "${BE_TAG}: skip-cycle check-runs 해석 실패(이번 주기 건너뜀)"; return 0 ;;
    esac
  fi
  if [[ "${sel}" != "${TIP}" ]]; then
    TARGET="${sel}"
    [[ -r "${BE_GREEN_FILE}" ]] && prev_sel="$(cat "${BE_GREEN_FILE}" 2>/dev/null || true)"
    if [[ ${DRY} == 1 || "${prev_sel}" != "${TIP} ${TARGET}" ]]; then
      log "${BE_TAG}: green-select: tip=${TIP:0:8} → target=${TARGET:0:8}"
    fi
    [[ ${DRY} == 1 ]] || printf '%s %s\n' "${TIP}" "${TARGET}" > "${BE_GREEN_FILE}" 2>/dev/null || true
    # 선택된 TARGET 기준으로 backend 변경을 다시 센다(tip 에만 backend 변경이 있었다면 이번엔 할 일 없음)
    mapfile -t BE_FILES < <(git_src diff --name-only "${PROD_HEAD}" "${TARGET}" -- backend/ 2>/dev/null)
    n="${#BE_FILES[@]}"
    if (( n == 0 )); then
      [[ ${DRY} == 1 ]] && say "백엔드 단계: green ${TARGET:0:8} 까지는 backend/ 변경 없음(tip ${TIP:0:8} 의 CI 를 기다림)"
      return 0
    fi
  fi
  for f in "${BE_FILES[@]}"; do
    case "${f}" in backend/uv.lock|backend/*pyproject.toml) uv_need=1; uv_note=" [uv sync 단계 포함]" ;; esac
  done
  if [[ -f "${BE_SKIPPED_FILE}" && "$(tr -d ' \r\n' < "${BE_SKIPPED_FILE}")" == "${TARGET}" ]]; then
    be_note wait skipped-ref "이전 자동 배포가 이 커밋에서 실패해 건너뜀(새 커밋을 기다림)"; return 0
  fi

  # 4) 조건 4: 범위 안 커밋마다 PR 을 찾아 라벨·'## 배포 메모' 를 본다(PR 을 못 찾거나 API 실패면 보류)
  local -a COMMITS=()
  mapfile -t COMMITS < <(git_src rev-list "${PROD_HEAD}..${TARGET}")
  if (( ${#COMMITS[@]} > BE_MAX_COMMITS )); then
    BE_TOK=""; be_note wait too-many-commits "범위 안 커밋 ${#COMMITS[@]}개(> ${BE_MAX_COMMITS}): 판정하지 않고 보류"; return 0
  fi
  local pr_dir; pr_dir="$(mktemp -d)"
  for c in "${COMMITS[@]}"; do
    if ! be_gh_get "commits/${c}/pulls?per_page=30" > "${pr_dir}/${c}.json"; then
      BE_TOK=""; rm -rf "${pr_dir}"
      log "${BE_TAG}: skip-cycle PR 조회 API 실패(${c:0:8}; 보류, 이번 주기 건너뜀)"; return 0
    fi
  done
  BE_TOK=""
  local pr_res
  pr_res="$("${PYTHON}" -I -c '
import json,re,sys,os
label,since,d=sys.argv[1],sys.argv[2],sys.argv[3]
memo=[];nopr=[];prs=[]
def section(body):
    body=re.sub(r"<!--.*?-->","",body or "",flags=re.S)
    out=None
    for ln in body.splitlines():
        s=ln.strip()
        if out is None:
            if re.match(r"^#{2}\s*배포\s*메모\s*$",s): out=[]
        else:
            if re.match(r"^#{1,6}\s",ln.lstrip()): break
            out.append(ln)
    return None if out is None else "\n".join(out)
for fn in sorted(os.listdir(d)):
    sha=fn[:-5]
    try: lst=json.load(open(os.path.join(d,fn),encoding="utf-8"))
    except Exception: print("error"); sys.exit()
    if not isinstance(lst,list): print("error"); sys.exit()
    if not lst: nopr.append(sha[:8]); continue
    for p in lst:
        num="#"+str(p.get("number"))
        if num not in prs: prs.append(num)
        names=[l.get("name") for l in (p.get("labels") or [])]
        if label in names: memo.append(num+" 라벨 "+label); continue
        sec=section(p.get("body"))
        if sec is None:
            if since and (not p.get("merged_at") or p["merged_at"][:10]>=since): memo.append(num+" 본문에 배포 메모 섹션 없음")
            continue
        norm=re.sub(r"[\s\.\-\*_`~>:!]+","",sec)
        if norm not in ("","없음"): memo.append(num+" 배포 메모 있음")
print("memo|"+"; ".join(memo) if memo else ("nopr|"+",".join(nopr) if nopr else "ok|"+" ".join(prs)))
' "${MEMO_LABEL}" "${MEMO_REQUIRED_SINCE}" "${pr_dir}" 2>/dev/null || echo error)"
  rm -rf "${pr_dir}"
  [[ ${MODE} == dry-run ]] && hold_tag="(dry-run)"
  case "${pr_res}" in
    memo\|*)
      be_note hold-memo memo "배포 메모 판정: ${pr_res#memo|}" \
"[tencent] 자동 배포 보류${hold_tag}: ${pr_res#memo|}. 손으로 배포해 주세요. 대상 ${TARGET:0:8}.${uv_note}"
      return 0 ;;
    nopr\|*) be_note wait no-pr "PR 을 못 찾은 커밋 ${pr_res#nopr|}: 판정 불가라 보류"; return 0 ;;
    ok\|*) ;;
    *) log "${BE_TAG}: skip-cycle PR 응답 해석 실패(이번 주기 건너뜀)"; return 0 ;;
  esac

  # 5) 조건 5: 허용 시각(AX_ALLOW_HOURS, 기본 24시간. 요일 제한 없음), dev 최신 커밋 조용한 구간, 최소 간격, 대기 건
  hour="$(TZ="${BE_TZ}" date -d "@${BE_NOW}" +%H 2>/dev/null || true)"
  if [[ ! "${hour}" =~ ^[0-9]{2}$ ]]; then log "${BE_TAG}: skip-cycle 시각을 못 구함(이번 주기 건너뜀)"; return 0; fi
  if [[ ! "${ALLOW_HOURS}" =~ ^([0-9]{1,2})-([0-9]{1,2})$ ]]; then
    log "${BE_TAG}: skip-cycle AX_ALLOW_HOURS 형식 오류(시작-끝, 예 0-24; 이번 주기 건너뜀)"; return 0
  fi
  h_from="${BASH_REMATCH[1]}"; h_to="${BASH_REMATCH[2]}"
  local in_hours=1
  if (( 10#${h_from} < 10#${h_to} )); then
    (( 10#${hour} >= 10#${h_from} && 10#${hour} < 10#${h_to} )) || in_hours=0
  elif (( 10#${h_from} > 10#${h_to} )); then   # 밤을 넘기는 창(예 22-6)
    (( 10#${hour} >= 10#${h_from} || 10#${hour} < 10#${h_to} )) || in_hours=0
  else in_hours=0; fi
  if (( ! in_hours )); then
    be_note wait outside-hours "KST ${hour}시는 배포 허용 시각(${ALLOW_HOURS}) 밖"; return 0
  fi
  last="$(git_src log -1 --format=%ct "${TARGET}" 2>/dev/null || true)"
  if [[ ! "${last}" =~ ^[0-9]+$ ]]; then log "${BE_TAG}: skip-cycle 최신 커밋 시각을 못 읽음(이번 주기 건너뜀)"; return 0; fi
  age=$(( BE_NOW - last ))
  if (( age < BE_QUIET_SEC )); then
    be_defer not-quiet "dev 최신 커밋이 ${age}초 전(조용해지려면 ${BE_QUIET_SEC}초 필요)"; return 0
  fi
  if [[ -r "${BE_LAST_RESTART_FILE}" ]]; then
    gap="$(tr -d ' \r\n' < "${BE_LAST_RESTART_FILE}")"
    if [[ "${gap}" =~ ^[0-9]+$ ]] && (( BE_NOW - gap < BE_MIN_GAP_SEC )); then
      be_defer min-gap "마지막 재시작이 $(( BE_NOW - gap ))초 전(최소 ${BE_MIN_GAP_SEC}초)"; return 0
    fi
  fi
  if [[ -n "${BUSY_URLS}" ]] && ! be_busy; then
    be_defer busy "승인 대기·긴 작업 중: ${BUSY_WHY}"; return 0
  fi

  if [[ ${MODE} == on ]]; then
    local rc=0
    BE_DEPLOYED="${TARGET}"
    be_deploy "${pr_res#ok|}" "${n}" "${uv_need}" || rc=$?
    return "${rc}"
  fi
  be_note would-deploy would-deploy "지금이면 배포했을 것(backend ${n}개 파일, PR ${pr_res#ok|}, CI ci·backend 통과)${uv_note}" \
"[tencent] 자동 배포(dry-run, 실제 배포 안 함): 백엔드 ${PROD_HEAD:0:8} → ${TARGET:0:8} 를 지금이면 배포하고 재시작했을 것입니다.
포함 PR: ${pr_res#ok|} (backend ${n}개 파일) / CI: ci·backend 통과${uv_note}
재시작하면 메모리에만 있는 상태(승인 대기·진행 중 작업)가 지워집니다."
  return 0
}
# 홍보 사이트 배포 대상: 이미 PROMO_ROOT 에 있는 파일 + assets/·instagram/assets/ 아래 새 파일. 내부 문서·소스는 배포하지 않는다.
promo_allowed() { # $1=docs/promo 아래 상대 경로
  local rel="$1"
  case "${rel}" in *.mjs|*.md|*.sh|*.py|*.json|*.test.*|INTAKE*|README*|content.*|build.*) return 1 ;; esac
  [[ -f "${PROMO_ROOT}/${rel}" ]] && return 0
  [[ "${rel}" == assets/* || "${rel}" == instagram/assets/* ]] && return 0
  return 1
}

# 백엔드를 배포한 주기에는 프론트 단계를 건너뛰고 기준 ref 만 올린다(프론트는 deploy-bundle 이 같이 빌드). 그러면 같은 묶음의
# docs/promo 변경은 영영 홍보 사이트에 안 올라간다(11/26 #1907). 그래서 기준을 올리기 전에 기준..배포한 커밋 사이의 홍보 파일을 먼저 올린다.
# 새 파일 먼저, index.html 마지막. 하나라도 실패하면 이전 파일로 되돌리고 1 을 돌려준다(그러면 기준 ref 를 올리지 않아 다음 주기가 다시 시도한다).
promo_catchup() { # $1=기준 ref $2=배포한 커밋
  local from="$1" to="$2" f rel dst tmp ok=1 code
  local -a changed=() files=() later=()
  mapfile -t changed < <(git_src diff --name-only "${from}" "${to}" -- docs/promo)
  for f in "${changed[@]}"; do
    rel="${f#docs/promo/}"
    if git_src cat-file -e "${to}:${f}" 2>/dev/null && promo_allowed "${rel}"; then
      if [[ "${rel}" == index.html ]]; then later+=("${rel}"); else files+=("${rel}"); fi
    fi
  done
  files+=("${later[@]}")
  (( ${#files[@]} > 0 )) || return 0
  if [[ ${DRY} == 1 ]]; then say "백엔드 배포 뒤 홍보 파일 ${#files[@]}개를 같이 올린다: ${files[*]}"; return 0; fi
  tmp="$(mktemp -d)"
  local pbk="${STATE_DIR}/prev-promo"; ${SUDO} rm -rf "${pbk}" "${pbk}.added"; mkdir -p "${pbk}"; : > "${pbk}.added"
  for rel in "${files[@]}"; do
    mkdir -p "${tmp}/$(dirname "${rel}")"
    git_src show "${to}:docs/promo/${rel}" > "${tmp}/${rel}" || { ok=0; break; }
    dst="${PROMO_ROOT}/${rel}"
    if [[ -f "${dst}" ]]; then mkdir -p "${pbk}/$(dirname "${rel}")"; ${SUDO} cp -a "${dst}" "${pbk}/${rel}"; else echo "${rel}" >> "${pbk}.added"; fi
    if ! ${SUDO} install -D -o root -g root -m 644 "${tmp}/${rel}" "${dst}" || ! cmp -s "${tmp}/${rel}" "${dst}"; then ok=0; break; fi
  done
  if (( ok )) && [[ "${URL_PROMO}" != "off" ]]; then
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "${URL_PROMO}" || true)"
    [[ "${code}" == "200" ]] || { log "verify: 홍보 사이트 HTTP ${code:-000}"; ok=0; }
  fi
  if (( ! ok )); then
    for rel in "${files[@]}"; do [[ -f "${pbk}/${rel}" ]] && ${SUDO} cp -a "${pbk}/${rel}" "${PROMO_ROOT}/${rel}"; done
    while read -r rel; do [[ -n "${rel}" ]] && ${SUDO} rm -f "${PROMO_ROOT}/${rel}"; done < "${pbk}.added"
    log "restore: 백엔드 배포 뒤 홍보 파일 올리기 실패, 이전 상태로 복원(기준 ref 는 그대로 ${from:0:8})"
    rm -rf "${tmp}"; return 1
  fi
  log "promo: 백엔드 배포 ${to:0:8} 와 같은 묶음의 홍보 파일 ${#files[@]}개 갱신 완료(${PROMO_ROOT})"
  rm -rf "${tmp}"; return 0
}

be_rc=0
backend_stage || be_rc=$?
case "${be_rc}" in
  0) ;;
  10) # 배포 완료: deploy-bundle 이 프론트도 다시 빌드했으므로 이번 주기의 프론트 단계는 건너뛰고 기준만 갱신한다(기준은 실제 배포한 green TARGET).
      # 단 홍보 파일은 번들에 없으니 기준을 올리기 전에 같은 묶음의 홍보 변경을 먼저 올린다. 실패하면 기준을 올리지 않아 다음 주기에 다시 한다.
    if ! promo_catchup "${LAST}" "${BE_DEPLOYED:-${TARGET}}"; then
      heartbeat "backend-deployed-promo-failed ${BE_DEPLOYED:0:8}"; log "FAIL: 백엔드는 배포됐지만 홍보 파일 올리기 실패(기준 ref 그대로 ${LAST:0:8}, 다음 주기에 다시 시도)"; exit 1
    fi
    advance_ref "${BE_DEPLOYED:-${TARGET}}"; heartbeat "backend-deployed ${BE_DEPLOYED:0:8}"; log "done: 백엔드 배포 완료, 기준 ref -> ${BE_DEPLOYED:0:8}"; exit 0 ;;
  11) heartbeat "backend-rolled-back ${BE_DEPLOYED:0:8}"; exit 0 ;;   # 되돌림 완료. 프론트는 다음 주기부터 평소대로
  12) heartbeat "backend-rollback-failed ${BE_DEPLOYED:0:8}"; exit 1 ;;
  *) log "${BE_TAG}: skip-cycle 내부 오류(rc=${be_rc}; 이번 주기 건너뜀)" ;;
esac

if [[ "${TARGET}" == "${LAST}" ]]; then
  heartbeat "up-to-date ${TARGET:0:8}"
  [[ ${DRY} == 1 ]] && say "배포할 것 없음: origin/${BRANCH}=${TARGET:0:8} 가 기준과 같다"
  exit 0
fi
if [[ -f "${SKIP_FILE}" && "$(tr -d ' \r\n' < "${SKIP_FILE}")" == "${TARGET}" ]]; then
  heartbeat "skipped-ref ${TARGET:0:8}"
  [[ ${DRY} == 1 ]] && say "건너뜀: ${TARGET:0:8} 는 ${MAX_FAILS}회 연속 실패로 건너뛰는 커밋(다음 새 커밋을 기다림)"
  exit 0
fi

# ---- 변경 판단 ------------------------------------------------------------------------------------
mapfile -t ALL_FILES < <(git_src diff --name-only "${LAST}" "${TARGET}")
NALL="${#ALL_FILES[@]}"
if (( NALL > MAX_FILES )); then
  log "abort: 변경 파일 ${NALL}개(> ${MAX_FILES}) 비정상. 배포하지 않음 ${LAST:0:8}..${TARGET:0:8}"
  heartbeat "abort-too-many-files"
  exit 1
fi

FE_FILES=(); PROMO_FILES=(); BACKEND_N=0
for f in "${ALL_FILES[@]}"; do
  case "${f}" in
    frontend/*.md|frontend/*.test.ts|frontend/*.test.tsx) ;;           # 문서·시험만 바뀐 것은 화면과 무관
    frontend/*) FE_FILES+=("${f}") ;;
    docs/promo/*)
      rel="${f#docs/promo/}"
      # 저장소에서 지워진 파일은 건드리지 않는다(서버 파일 삭제 안 함)
      if git_src cat-file -e "${TARGET}:${f}" 2>/dev/null && promo_allowed "${rel}"; then PROMO_FILES+=("${rel}"); fi ;;
    backend/*) BACKEND_N=$((BACKEND_N + 1)) ;;
  esac
done

# frontend/ 또는 docs/promo 를 건드린 커밋 목록(보고용)
mapfile -t FE_COMMITS < <(git_src log --format='%h %s' --no-merges "${LAST}..${TARGET}" -- frontend docs/promo | cut -c1-150)

if (( BACKEND_N > 0 )); then
  if [[ "${BACKEND_STAGE}" == off ]]; then
    log "backend-changed: manual deploy needed (backend/ 변경 ${BACKEND_N}개 ${LAST:0:8}..${TARGET:0:8}; 자동 배포는 프론트만 한다)"
  else
    log "backend-changed: backend/ 변경 ${BACKEND_N}개 ${LAST:0:8}..${TARGET:0:8}; 백엔드 자동 배포(${BACKEND_STAGE})는 이 단계가 아니라 위 backend 판정에서 한다(이번 주기 보류 사유는 위 ${BE_TAG:-backend}: 로그 참조). 이 단계는 프론트·홍보만 배포"
  fi
fi

DO_FE=0; DO_PROMO=0
if (( ${#FE_FILES[@]} > 0 )); then DO_FE=1; fi
if (( ${#PROMO_FILES[@]} > 0 )); then DO_PROMO=1; fi

if (( DO_FE == 0 && DO_PROMO == 0 )); then
  log "no-web-change: ${LAST:0:8}..${TARGET:0:8} 변경 ${NALL}개 중 프론트·홍보 웹 파일 없음 -> 기준만 갱신"
  advance_ref "${TARGET}"
  heartbeat "no-web-change ${TARGET:0:8}"
  [[ ${DRY} == 1 ]] && say "배포할 것 없음(웹 파일 변경 없음). 실제 실행이면 기준을 ${TARGET:0:8} 로 갱신한다"
  exit 0
fi

# ---- CI 확인 --------------------------------------------------------------------------------------
# 반환: 0 통과(또는 확인 꺼짐), 1 실패, 2 아직 진행 중/확인 불가(다음 주기에 다시)
CI_STATE=""
ci_check() {
  if [[ ! -r "${CI_TOKEN_FILE}" ]]; then CI_STATE="ci-check=off"; return 0; fi
  local tok body verdict
  tok="$(tr -d ' \r\n' < "${CI_TOKEN_FILE}")"
  [[ -n "${tok}" ]] || { CI_STATE="ci-check=off(empty token file)"; return 0; }
  body="$(curl -fsS --max-time 30 -H "Authorization: Bearer ${tok}" -H 'Accept: application/vnd.github+json' \
           "https://api.github.com/repos/${GITHUB_REPO}/commits/${TARGET}/check-runs?per_page=100" 2>/dev/null)" \
    || { CI_STATE="ci-check=api-error(${TARGET:0:8})"; return 2; }
  verdict="$(printf '%s' "${body}" | "${PYTHON}" -I -c '
import json,sys
d=json.load(sys.stdin); runs=d.get("check_runs",[])
if not runs: print("none"); sys.exit()
if any(r.get("status")!="completed" for r in runs): print("pending"); sys.exit()
bad=[r for r in runs if r.get("conclusion") not in ("success","skipped","neutral")]
print("fail" if bad else "ok")' 2>/dev/null || echo "parse-error")"
  case "${verdict}" in
    ok) CI_STATE="ci-check=pass(${TARGET:0:8})"; return 0 ;;
    fail) CI_STATE="ci-check=FAILED(${TARGET:0:8})"; return 1 ;;
    *) CI_STATE="ci-check=${verdict}(${TARGET:0:8})"; return 2 ;;
  esac
}
ci_rc=0; ci_check || ci_rc=$?

# ---- dry-run 보고 ---------------------------------------------------------------------------------
if [[ ${DRY} == 1 ]]; then
  say "== ax-autodeploy --dry-run =="
  say "기준(last-deployed-ref): ${LAST}"
  say "대상(origin/${BRANCH}):   ${TARGET}"
  say "변경 파일 ${NALL}개: frontend(화면 관련) ${#FE_FILES[@]}개, 홍보 웹 ${#PROMO_FILES[@]}개, backend ${BACKEND_N}개"
  say "게이트 정지 연결: ${GATE_STATE}"
  say "CI: ${CI_STATE} (rc=${ci_rc}; 0이 아니면 이번 주기엔 배포하지 않는다)"
  say "frontend/·docs/promo 를 건드린 커밋:"
  if (( ${#FE_COMMITS[@]} > 0 )); then printf '  %s\n' "${FE_COMMITS[@]}"; fi
  if (( DO_FE )); then say "할 일: 프론트 ${WEB_ROOT_90} 과 ${WEB_ROOT_91} 를 ${TARGET:0:8} 로 재빌드·교체(deploy.sh 2회), 이후 토큰 검사"; fi
  if (( DO_PROMO )); then say "할 일: 홍보 파일 ${#PROMO_FILES[@]}개 갱신/추가(${PROMO_ROOT}):"; printf '  %s\n' "${PROMO_FILES[@]}"; fi
  if (( BACKEND_N > 0 )); then
    if [[ "${BACKEND_STAGE}" == off ]]; then say "주의: backend 변경 ${BACKEND_N}개는 배포하지 않는다(backend-changed: manual deploy needed)"
    else say "참고: backend 변경 ${BACKEND_N}개는 이 단계가 아니라 백엔드 자동 단계(${BACKEND_STAGE})가 판정한다"; fi
  fi
  exit 0
fi

if (( ci_rc != 0 )); then
  log "wait: ${CI_STATE} -> 이번 주기엔 배포하지 않음"
  heartbeat "ci-wait ${TARGET:0:8}"
  exit 0
fi
log "start: ${LAST:0:8}..${TARGET:0:8} fe=${DO_FE}(${#FE_FILES[@]}) promo=${DO_PROMO}(${#PROMO_FILES[@]}) ${CI_STATE}"

# ---- 실패 처리 ------------------------------------------------------------------------------------
note_failure() { # $1=사유
  local n=1 prev_sha="" prev_n=0
  if [[ -f "${FAIL_FILE}" ]]; then
    read -r prev_sha prev_n < "${FAIL_FILE}" || true
    if [[ "${prev_sha}" == "${TARGET}" ]]; then n=$(( ${prev_n:-0} + 1 )); fi
  fi
  printf '%s %s\n' "${TARGET}" "${n}" > "${FAIL_FILE}"
  log "FAIL(${n}/${MAX_FAILS}): $1 (기준 ref 는 그대로 ${LAST:0:8})"
  if (( n >= MAX_FAILS )); then
    printf '%s\n' "${TARGET}" > "${SKIP_FILE}"
    log "skip-commit: ${TARGET:0:8} 가 ${MAX_FAILS}회 연속 실패 -> 다음 새 커밋을 기다림(상태: ${SKIP_FILE})"
  fi
  heartbeat "failed ${TARGET:0:8}"
}

# ---- 백업·복원 ------------------------------------------------------------------------------------
BACKED=()      # 백업해 둔 웹 루트
backup_root() { # $1=웹 루트
  local r="$1" b="${PREV_DIR}/$(basename "$1")"
  [[ -d "${r}" ]] || return 0
  ${SUDO} rm -rf "${b}"; mkdir -p "${PREV_DIR}"
  ${SUDO} cp -a "${r}" "${b}"
  BACKED+=("${r}")
}
restore_root() { # $1=웹 루트
  local r="$1" b="${PREV_DIR}/$(basename "$1")"
  [[ -d "${b}" ]] || { log "restore: 백업 ${b} 없음, ${r} 복원 못함"; return 1; }
  ${SUDO} rm -rf "${r}.restore" "${r}.bad"
  ${SUDO} cp -a "${b}" "${r}.restore"
  if [[ -d "${r}" ]]; then ${SUDO} mv "${r}" "${r}.bad"; fi
  ${SUDO} mv "${r}.restore" "${r}"
  ${SUDO} rm -rf "${r}.bad"
  log "restore: ${r} 이전 화면으로 복원"
}
restore_all() { local r; for r in "${BACKED[@]}"; do restore_root "${r}" || true; done; }

# 예상 못 한 오류·종료 신호(타임아웃 포함)에도 이전 화면으로 되돌린다
DEPLOYING=0
on_exit() {
  local rc=$?
  if (( DEPLOYING == 1 && rc != 0 )); then
    DEPLOYING=0
    log "unexpected-exit(rc=${rc}): 이전 화면으로 복원 시도"
    restore_all
    note_failure "예상 못 한 종료(rc=${rc})"
  fi
}
trap on_exit EXIT
trap 'exit 143' TERM INT

# ---- 토큰 검사 ------------------------------------------------------------------------------------
# 번들에 공용 사람·작업·관리자 토큰의 "실제 값"이 없고 자리표시자만 있는지 본다. 값은 출력하지 않는다.
token_check() { # $1.. = 웹 루트
  local list rc=0 r f
  list="$(mktemp)"; chmod 600 "${list}"
  {
    # nginx 가 채워 넣는 실제 사람 토큰(Bearer 뒤 값)
    ${SUDO} sed -n 's/.*"Bearer \([^"]*\)".*/\1/p' "${HUMAN_MAP_FILE}" 2>/dev/null || true
    # 운영 .env·tokens.env 의 사람/작업/관리자 토큰(열람 전용 SHOP_VIEWER_TOKEN 은 번들에 들어가는 것이 정상이라 제외)
    for f in "${PROD_REPO}/backend/.env" /opt/axcellent/tokens.env; do
      if [[ -r "${f}" ]]; then
        sed -n -E 's/^(HUMAN_TOKEN|WORK_TOKEN|[A-Z_]*ADMIN[A-Z_]*TOKEN|[A-Z_]*HUMAN[A-Z_]*TOKEN)=//p' "${f}" | tr -d '"' || true
      fi
    done
  } | awk -v ph="${HUMAN_PLACEHOLDER}" 'length($0)>=16 && $0!=ph' | sort -u > "${list}.v" || true
  mv -f "${list}.v" "${list}"
  if [[ ! -s "${list}" ]]; then
    log "token-check: 비교할 실제 토큰 값을 하나도 못 읽었다(검사 불가) -> 실패 처리"
    rm -f "${list}"; return 1
  fi
  for r in "$@"; do
    if grep -rIlF -f "${list}" "${r}" >/dev/null 2>&1; then
      log "token-check: ${r} 번들에 실제 토큰 값이 들어 있다(값은 기록 안 함)"; rc=1
    elif ! grep -rIlF -- "${HUMAN_PLACEHOLDER}" "${r}/assets" >/dev/null 2>&1; then
      log "token-check: ${r} 번들에 자리표시자(${HUMAN_PLACEHOLDER})가 없다"; rc=1
    fi
  done
  rm -f "${list}"
  return "${rc}"
}

# ---- 화면 확인 ------------------------------------------------------------------------------------
verify_root() { # $1=웹 루트 $2=URL
  local r="$1" code a
  [[ -f "${r}/index.html" ]] || { log "verify: ${r}/index.html 없음"; return 1; }
  while read -r a; do
    [[ -z "${a}" ]] && continue
    [[ -f "${r}/${a}" ]] || { log "verify: ${r} 의 index.html 이 가리키는 ${a} 가 없다"; return 1; }
  done < <(grep -oE '(src|href)="/assets/[^"]+"' "${r}/index.html" | sed -E 's/^[a-z]+="\/?//; s/"$//')
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$2" || true)"
  [[ "${code}" == "200" ]] || { log "verify: $2 -> HTTP ${code:-000}"; return 1; }
  return 0
}

# ---- 배포 -----------------------------------------------------------------------------------------
if ! git_src checkout --quiet --force --detach "${TARGET}"; then note_failure "빌드 트리 checkout 실패"; exit 1; fi
git_src clean -fdq || true
: > "${BUILD_LOG}" 2>/dev/null || true
DEPLOYING=1

if (( DO_FE )); then
  # 읽기 전용 열람 토큰만 운영 backend/.env 에서 읽어 빌드에 넘긴다(수동 배포와 같은 동작). 값은 출력하지 않는다.
  VIEWER=""
  if [[ -r "${PROD_REPO}/backend/.env" ]]; then
    VIEWER="$(sed -n 's/^SHOP_VIEWER_TOKEN=//p' "${PROD_REPO}/backend/.env" | head -n1 | tr -d '"')" || true
  fi
  [[ -n "${VIEWER}" ]] || log "warn: SHOP_VIEWER_TOKEN 을 못 읽음(열람 토큰 없이 빌드)"
  backup_root "${WEB_ROOT_90}"; backup_root "${WEB_ROOT_91}"
  fe_ok=1
  for pair in "${WEB_ROOT_90}|${URL_90}" "${WEB_ROOT_91}|${URL_91}"; do
    root="${pair%%|*}"; url="${pair##*|}"
    if ! env AXCELLENT_REPO="${SRC}" AXCELLENT_REF="${TARGET}" \
          VITE_SAFETY_HUMAN_TOKEN="${HUMAN_PLACEHOLDER}" VITE_SHOP_WEB_URL= VITE_SHOP_VIEWER_TOKEN="${VIEWER}" \
          AXCELLENT_WEB_ROOT="${root}" AXCELLENT_URL="${url}" \
          timeout "${DEPLOY_TIMEOUT}" "${DEPLOY_SH}" >> "${BUILD_LOG}" 2>&1; then
      log "deploy.sh 실패 또는 시간 초과(root=${root}; 출력은 ${BUILD_LOG}, 비밀값 없음)"; fe_ok=0; break
    fi
  done
  VIEWER=""
  if (( fe_ok )); then
    if ! { verify_root "${WEB_ROOT_90}" "${URL_90}" && verify_root "${WEB_ROOT_91}" "${URL_91}"; }; then fe_ok=0; fi
  fi
  if (( fe_ok )); then token_check "${WEB_ROOT_90}" "${WEB_ROOT_91}" || fe_ok=0; fi
  if (( ! fe_ok )); then
    DEPLOYING=0
    restore_all
    note_failure "프론트 배포/검증 실패"
    exit 1
  fi
  log "frontend: ${TARGET:0:8} 배포·검증 완료(${WEB_ROOT_90}, ${WEB_ROOT_91})"
fi

if (( DO_PROMO )); then
  PBK="${STATE_DIR}/prev-promo"; ${SUDO} rm -rf "${PBK}" "${PBK}.added"; mkdir -p "${PBK}"; : > "${PBK}.added"
  promo_ok=1
  for rel in "${PROMO_FILES[@]}"; do
    src_f="${SRC}/docs/promo/${rel}"; dst="${PROMO_ROOT}/${rel}"
    if [[ -f "${dst}" ]]; then
      mkdir -p "${PBK}/$(dirname "${rel}")"; ${SUDO} cp -a "${dst}" "${PBK}/${rel}"
    else
      echo "${rel}" >> "${PBK}.added"
    fi
    if ! ${SUDO} install -D -o root -g root -m 644 "${src_f}" "${dst}" || ! cmp -s "${src_f}" "${dst}"; then promo_ok=0; break; fi
  done
  if [[ "${URL_PROMO}" != "off" ]]; then
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "${URL_PROMO}" || true)"
    [[ "${code}" == "200" ]] || { log "verify: 홍보 사이트 HTTP ${code:-000}"; promo_ok=0; }
  fi
  if (( ! promo_ok )); then
    DEPLOYING=0
    for rel in "${PROMO_FILES[@]}"; do
      if [[ -f "${PBK}/${rel}" ]]; then ${SUDO} cp -a "${PBK}/${rel}" "${PROMO_ROOT}/${rel}"; fi
    done
    while read -r rel; do
      if [[ -n "${rel}" ]]; then ${SUDO} rm -f "${PROMO_ROOT}/${rel}"; fi
    done < "${PBK}.added"
    log "restore: 홍보 파일 이전 상태로 복원"
    # 프론트는 이미 배포·검증됐으므로 되돌리지 않는다. 기준 ref 는 그대로라 다음 주기에 다시 시도한다.
    note_failure "홍보 파일 배포/검증 실패"
    exit 1
  fi
  log "promo: ${#PROMO_FILES[@]}개 파일 갱신 완료(${PROMO_ROOT})"
fi

DEPLOYING=0
advance_ref "${TARGET}"
log "done: 기준 ref -> ${TARGET:0:8}"
heartbeat "deployed ${TARGET:0:8}"
exit 0
