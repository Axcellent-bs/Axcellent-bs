if (( DO_FE )); then
  # 읽기 전용 열람 토큰만 운영 backend/.env 에서 읽어 빌드에 넘긴다(수동 배포와 같은 동작). 값은 출력하지 않는다.
  VIEWER=""
  if [[ -r "${PROD_REPO}/backend/.env" ]]; then
    VIEWER="$(sed -n 's/^SHOP_VIEWER_TOKEN=//p' "${PROD_REPO}/backend/.env" | head -n1 | tr -d '"')" || true
  fi
  [[ -n "${VIEWER}" ]] || log "warn: SHOP_VIEWER_TOKEN 을 못 읽음(열람 토큰 없이 빌드)"
  backup_root "${WEB_ROOT_90}"; backup_root "${WEB_ROOT_91}"
  fe_ok=1
