  say "게이트 정지 연결: ${GATE_STATE}"
  say "CI: ${CI_STATE} (rc=${ci_rc}; 0이 아니면 이번 주기엔 배포하지 않는다)"
  say "frontend/·docs/promo 를 건드린 커밋:"
  if (( ${#FE_COMMITS[@]} > 0 )); then printf '  %s\n' "${FE_COMMITS[@]}"; fi
  if (( DO_FE )); then say "할 일: 프론트 ${WEB_ROOT_90} 과 ${WEB_ROOT_91} 를 ${TARGET:0:8} 로 재빌드·교체(deploy.sh 2회), 이후 토큰 검사"; fi
  if (( DO_PROMO )); then say "할 일: 홍보 파일 ${#PROMO_FILES[@]}개 갱신/추가(${PROMO_ROOT}):"; printf '  %s\n' "${PROMO_FILES[@]}"; fi
  if (( BACKEND_N > 0 )); then say "주의: backend 변경 ${BACKEND_N}개는 배포하지 않는다(backend-changed: manual deploy needed)"; fi
