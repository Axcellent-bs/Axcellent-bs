# ---- 실패 처리 ------------------------------------------------------------------------------------
note_failure() { # $1=사유
  local n=1 prev_sha="" prev_n=0
  if [[ -f "${FAIL_FILE}" ]]; then
    read -r prev_sha prev_n < "${FAIL_FILE}" || true
    if [[ "${prev_sha}" == "${TARGET}" ]]; then n=$(( ${prev_n:-0} + 1 )); fi
  fi
  printf '%s %s\n' "${TARGET}" "${n}" > "${FAIL_FILE}"
  log "FAIL(${n}/${MAX_FAILS}): $1 (기준 ref 는 그대로 ${LAST:0:8})"
  if (( n >= MAX_FAILS )); then
    printf '%s\n' "${TARGET}" > "${SKIP_FILE}"
    log "skip-commit: ${TARGET:0:8} 가 ${MAX_FAILS}회 연속 실패 -> 다음 새 커밋을 기다림(상태: ${SKIP_FILE})"
  fi
  heartbeat "failed ${TARGET:0:8}"
}

# ---- 백업·복원 ------------------------------------------------------------------------------------
BACKED=()      # 백업해 둔 웹 루트
backup_root() { # $1=웹 루트
  local r="$1" b="${PREV_DIR}/$(basename "$1")"
  [[ -d "${r}" ]] || return 0
  ${SUDO} rm -rf "${b}"; mkdir -p "${PREV_DIR}"
  ${SUDO} cp -a "${r}" "${b}"
  BACKED+=("${r}")
}
restore_root() { # $1=웹 루트
  local r="$1" b="${PREV_DIR}/$(basename "$1")"
  [[ -d "${b}" ]] || { log "restore: 백업 ${b} 없음, ${r} 복원 못함"; return 1; }
  ${SUDO} rm -rf "${r}.restore" "${r}.bad"
  ${SUDO} cp -a "${b}" "${r}.restore"
  if [[ -d "${r}" ]]; then ${SUDO} mv "${r}" "${r}.bad"; fi
  ${SUDO} mv "${r}.restore" "${r}"
  ${SUDO} rm -rf "${r}.bad"
  log "restore: ${r} 이전 화면으로 복원"
}
restore_all() { local r; for r in "${BACKED[@]}"; do restore_root "${r}" || true; done; }

# 예상 못 한 오류·종료 신호(타임아웃 포함)에도 이전 화면으로 되돌린다
DEPLOYING=0
on_exit() {
  local rc=$?
  if (( DEPLOYING == 1 && rc != 0 )); then
    DEPLOYING=0
    log "unexpected-exit(rc=${rc}): 이전 화면으로 복원 시도"
    restore_all
    note_failure "예상 못 한 종료(rc=${rc})"
  fi
}
trap on_exit EXIT
trap 'exit 143' TERM INT

# ---- 토큰 검사 ------------------------------------------------------------------------------------
# 번들에 공용 사람·작업·관리자 토큰의 "실제 값"이 없고 자리표시자만 있는지 본다. 값은 출력하지 않는다.
token_check() { # $1.. = 웹 루트
  local list rc=0 r f
  list="$(mktemp)"; chmod 600 "${list}"
  {
    # nginx 가 채워 넣는 실제 사람 토큰(Bearer 뒤 값)
    ${SUDO} sed -n 's/.*"Bearer \([^"]*\)".*/\1/p' "${HUMAN_MAP_FILE}" 2>/dev/null || true
    # 운영 .env·tokens.env 의 사람/작업/관리자 토큰(열람 전용 SHOP_VIEWER_TOKEN 은 번들에 들어가는 것이 정상이라 제외)
    for f in "${PROD_REPO}/backend/.env" /opt/axcellent/tokens.env; do
      if [[ -r "${f}" ]]; then
        sed -n -E 's/^(HUMAN_TOKEN|WORK_TOKEN|[A-Z_]*ADMIN[A-Z_]*TOKEN|[A-Z_]*HUMAN[A-Z_]*TOKEN)=//p' "${f}" | tr -d '"' || true
      fi
    done
  } | awk -v ph="${HUMAN_PLACEHOLDER}" 'length($0)>=16 && $0!=ph' | sort -u > "${list}.v" || true
  mv -f "${list}.v" "${list}"
  if [[ ! -s "${list}" ]]; then
    log "token-check: 비교할 실제 토큰 값을 하나도 못 읽었다(검사 불가) -> 실패 처리"
    rm -f "${list}"; return 1
  fi
  for r in "$@"; do
    if grep -rIlF -f "${list}" "${r}" >/dev/null 2>&1; then
      log "token-check: ${r} 번들에 실제 토큰 값이 들어 있다(값은 기록 안 함)"; rc=1
    elif ! grep -rIlF -- "${HUMAN_PLACEHOLDER}" "${r}/assets" >/dev/null 2>&1; then
      log "token-check: ${r} 번들에 자리표시자(${HUMAN_PLACEHOLDER})가 없다"; rc=1
    fi
  done
  rm -f "${list}"
  return "${rc}"
}

# ---- 화면 확인 ------------------------------------------------------------------------------------
verify_root() { # $1=웹 루트 $2=URL
  local r="$1" code a
  [[ -f "${r}/index.html" ]] || { log "verify: ${r}/index.html 없음"; return 1; }
  while read -r a; do
    [[ -z "${a}" ]] && continue
    [[ -f "${r}/${a}" ]] || { log "verify: ${r} 의 index.html 이 가리키는 ${a} 가 없다"; return 1; }
  done < <(grep -oE '(src|href)="/assets/[^"]+"' "${r}/index.html" | sed -E 's/^[a-z]+="\/?//; s/"$//')
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$2" || true)"
  [[ "${code}" == "200" ]] || { log "verify: $2 -> HTTP ${code:-000}"; return 1; }
  return 0
}

